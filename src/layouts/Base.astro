---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BookModal from '../components/BookModal.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { site } from '../data/site';
import { resolvePortrait } from '../data/portrait';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonld?: unknown[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portrait = resolvePortrait();
const { title, description, image = `${site.url}/${portrait.rel}`, type = 'website', jsonld = [] } = Astro.props;
// trailingSlash: 'always' — the served URL ends in '/', so the canonical must
// name that exact URL and never a redirecting variant (or a .html stub).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url);
const isNotFound = /\/404\/?$/.test(canonicalUrl.pathname);
const canonical = /\.[a-z0-9]+$/i.test(canonicalUrl.pathname)
  ? canonicalUrl.href
  : canonicalUrl.href.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === (base || '/') || path === '/';
const isContact = path.endsWith('/contact');
const isLegal = path.endsWith('/privacy') || path.endsWith('/terms');
const pageClass = isHome ? 'home-page' : path.includes('/books/') ? 'book-page' : path.includes('/series/') ? 'series-page' : isContact ? 'contact-page' : isLegal ? 'legal-page' : '';
const hasInkHero = pageClass !== '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content={hasInkHero ? '#191713' : '#f3f0e9'} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Sufi Ilham — Books" href={`${base}/rss.xml`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const theme = localStorage.getItem('theme');
          if (theme) root.dataset.theme = theme;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches)
            root.dataset.theme = 'dark';
        } catch {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches)
            root.dataset.theme = 'dark';
        }

        const optOut = [navigator.doNotTrack, window.doNotTrack, navigator.msDoNotTrack]
          .some((value) => ['1', 'yes'].includes(String(value).toLowerCase()))
          || navigator.globalPrivacyControl === true;
        if (!optOut) {
          window.plausible = window.plausible || function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
          const analytics = document.createElement('script');
          analytics.defer = true;
          analytics.dataset.domain = 'naiyern.github.io';
          analytics.src = 'https://plausible.io/js/script.outbound-links.js';
          document.head.appendChild(analytics);
        }
      })();
    </script>
    <noscript>
      <style>html { overflow: auto }</style>
    </noscript>
  </head>
  <body class={pageClass || undefined}>
    <div class="progress" id="progress"></div>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>

    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <BookModal />
    <CommandPalette />

    <!-- ambient soundtrack -->
    <audio id="bgm" loop preload="none" playsinline src={`${base}/sama.mp3`}></audio>

    <!-- cinematic Amazon hand-off -->
    <div class="go-ov" id="goOv" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="goTitle" aria-describedby="goSub" tabindex="-1">
      <div class="go-in">
        <div class="go-book" aria-hidden="true"></div>
        <div class="go-title" id="goTitle">Opening Amazon</div>
        <div class="go-sub" id="goSub">Taking you to the secure Amazon store…</div>
        <div class="go-bar"><i></i></div>
        <button class="go-cancel" type="button">Cancel</button>
      </div>
    </div>

    <button class="icon-btn to-top" id="toTop" aria-label="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
