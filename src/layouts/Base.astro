---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BookModal from '../components/BookModal.astro';
import CommandPalette from '../components/CommandPalette.astro';
import NextChapter from '../components/NextChapter.astro';
import FlowHud from '../components/FlowHud.astro';
import FlowBlend from '../components/FlowBlend.astro';
import { site } from '../data/site';
import { resolvePortrait } from '../data/portrait';
/* The two faces that paint first: the display serif of the masthead/hero and
   the reading serif of every paragraph. Preloading them lets the browser fetch
   the woff2 while it is still parsing CSS, so the first text paint is already
   in the right typeface instead of swapping into it. */
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import textFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonld?: unknown[];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portrait = resolvePortrait();
const { title, description, image = `${site.url}/${portrait.rel}?v=${portrait.version}`, type = 'website', jsonld = [] } = Astro.props;
// trailingSlash: 'always' — the served URL ends in '/', so the canonical must
// name that exact URL and never a redirecting variant (or a .html stub).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url);
const isNotFound = /\/404(?:\.html)?\/?$/.test(canonicalUrl.pathname);
const canonical = /\.[a-z0-9]+$/i.test(canonicalUrl.pathname)
  ? canonicalUrl.href
  : canonicalUrl.href.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === (base || '/') || path === '/';
const isContact = path.endsWith('/contact');
const isDiscover = path.endsWith('/discover');
const isLegal = path.endsWith('/privacy') || path.endsWith('/terms');
const pageClass = isHome ? 'home-page' : path.includes('/books/') ? 'book-page' : path.includes('/series/') ? 'series-page' : isDiscover ? 'discover-page' : isContact ? 'contact-page' : isLegal ? 'legal-page' : '';
const hasInkHero = pageClass !== '';
---

<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" id="themeColor" content={hasInkHero ? '#191713' : '#e9ddc6'} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Sufi Ilham — Books" href={`${base}/rss.xml`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    {jsonld.map((j: unknown) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}

    <script is:inline>
      (() => {
        // One fixed appearance; the js class is what gates the reveal
        // animations and the no-script fallbacks.
        document.documentElement.classList.add('js');

        const optOut = [navigator.doNotTrack, window.doNotTrack, navigator.msDoNotTrack]
          .some((value) => ['1', 'yes'].includes(String(value).toLowerCase()))
          || navigator.globalPrivacyControl === true;
        if (!optOut) {
          window.plausible = window.plausible || function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
          const analytics = document.createElement('script');
          analytics.defer = true;
          analytics.dataset.domain = 'sufiilham.co.uk';
          analytics.src = 'https://plausible.io/js/script.outbound-links.js';
          document.head.appendChild(analytics);
        }
      })();
    </script>
    <noscript>
      <style>html { overflow: auto }</style>
    </noscript>
  </head>
  <body class={pageClass || undefined}>
    <div class="veil" id="veil" aria-hidden="true"></div>
    <div class="aperture" aria-hidden="true"></div>
    <div class="progress" id="progress"></div>
    <FlowHud />
    <div class="grain" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>

    <Nav />
    <main id="main"><slot /></main>
    {isContact && <FlowBlend to="paper" />}
    {(pageClass === 'book-page' || pageClass === 'series-page' || isContact) && <NextChapter />}
    {!isNotFound && <FlowBlend to="ink" />}
    <Footer />
    <BookModal />
    <CommandPalette />

    <!-- ambient soundtrack -->
    <audio id="bgm" loop preload="none" playsinline src={`${base}/sama.mp3?v=2`}></audio>

    <!-- cinematic Amazon hand-off -->
    <div class="go-ov" id="goOv" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="goTitle" aria-describedby="goSub" tabindex="-1" inert>
      <div class="go-in">
        <div class="go-book" aria-hidden="true"></div>
        <div class="go-title" id="goTitle">Opening Amazon</div>
        <div class="go-sub" id="goSub">Taking you to the secure Amazon store…</div>
        <div class="go-bar"><i></i></div>
        <button class="go-cancel" type="button">Cancel</button>
      </div>
    </div>

    <button class="icon-btn to-top" id="toTop" aria-label="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
