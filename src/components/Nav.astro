---
import LangSwitch from './LangSwitch.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/#books`, label: 'Books', key: 'nav.books' },
  { href: `${base}/#series`, label: 'Series', key: 'nav.series' },
  { href: `${base}/#about`, label: 'About', key: 'nav.about' },
  { href: `${base}/#themes`, label: 'Themes', key: 'nav.themes' },
  { href: `${base}/#contact`, label: 'Contact', key: 'nav.contact' },
];
---

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand" href={`${base}/`} aria-label="Sufi Ilham — home">
      <span class="brand-mark">S</span>
      <span class="brand-txt"><b>Sufi Ilham</b><span>Author</span></span>
    </a>

    <nav id="menu" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href} data-i18n={l.key}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav-act">
      <LangSwitch />

      <button class="icon-btn" id="sndBtn" aria-label="Toggle ambient soundtrack" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M11 5 6 9H3v6h3l5 4V5z" />
          <path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7" />
          <path class="wave" d="M18.5 5.5a9 9 0 0 1 0 13" />
        </svg>
      </button>

      <button class="icon-btn" id="themeBtn" aria-label="Toggle colour theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" id="themeIcon">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <button class="icon-btn burger" id="burger" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
    </div>
  </div>
</header>
