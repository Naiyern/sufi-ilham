---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* The modal's data is served as one cached JSON file (/book-store.json) and
   fetched lazily by app.ts, instead of being inlined into every page. */
---

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="mTitle" data-store={`${base}/book-store.json`} data-base={base}>
  <div class="modal-in" id="modalIn">
    <button class="modal-close" id="modalClose" type="button" aria-label="Close details">✕</button>
    <div><img id="mImg" alt="" width="400" height="600" /></div>
    <div>
      <p class="modal-status" id="mStatus" hidden></p>
      <div class="kicker" id="mKicker"></div>
      <h2 id="mTitle"></h2>
      <p class="modal-alt" id="mAltTitle" hidden></p>
      <p class="q" id="mSub" hidden></p>
      <p class="q" id="mQuote" hidden></p>
      <div class="desc" id="mDesc"></div>
      <ul class="meta" id="mSpec"></ul>
      <div class="buy-row" id="mBuy"></div>
      <a class="modal-full-link" id="mPage" href={`${base}/`}>Open full book page <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>
