---
import { books, coverUrl } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* One shared store instead of repeating the full record in every
   data-book attribute (that duplication cost ~89KB on the home page). */
const store = Object.fromEntries(
  books.map((b) => [b.slug, {
    ...b,
    img: coverUrl(b.img, base),
  }]),
);
---

<script type="application/json" id="bookStore" set:html={JSON.stringify(store)}></script>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <div class="modal-in" id="modalIn">
    <button class="modal-close" id="modalClose" aria-label="Close">✕</button>
    <div><img id="mImg" src="" alt="" width="400" height="600" /></div>
    <div>
      <div class="kicker" id="mKicker"></div>
      <h2 id="mTitle"></h2>
      <p class="q" id="mSub"></p>
      <p class="q" id="mQuote"></p>
      <div class="desc" id="mDesc"></div>
      <ul class="meta" id="mSpec"></ul>
      <div class="buy-row" id="mBuy"></div>
    </div>
  </div>
</div>
