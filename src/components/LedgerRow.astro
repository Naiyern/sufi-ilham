---
import type { Book } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { book: Book; n: number }
const { book, n } = Astro.props;
const src = book.img.startsWith('http') ? book.img : `${base}/${book.img.replace(/^\//, '')}`;
const kindMap: Record<string, string> = {
  'self-help': 'Self-Help', philosophy: 'Philosophy', fiction: 'Fiction',
  romance: 'Romance', romantasy: 'Romantasy',
};
const tags = [book.genre, book.ku ? 'ku' : '', book.series ?? ''].filter(Boolean).join(' ');
---

<div
  class={`lrow${book.comingSoon ? ' soon' : ''}`}
  data-tags={tags}
  data-title={book.title.toLowerCase()}
  data-book={JSON.stringify(book)}
  data-cover={src}
  role="button"
  tabindex="0"
>
  <span class="n">{String(n).padStart(2, '0')}</span>
  <span class="ttl">
    {book.title}
    {book.sub && <small>{book.sub}</small>}
  </span>
  <span class="kind">{kindMap[book.genre ?? ''] ?? '—'}</span>
  <span class="pg">{book.comingSoon ? 'Forthcoming' : book.pages ? `${book.pages} pp` : '—'}</span>
  <span class="go">{book.comingSoon ? 'Soon' : 'Open →'}</span>
</div>
