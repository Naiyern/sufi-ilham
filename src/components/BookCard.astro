---
import { coverUrl } from '../data/site';
import type { Book } from '../data/site';
import Cover from './Cover.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { book: Book; delay?: number }
const { book, delay = 0 } = Astro.props;
const src = coverUrl(book.img, base);
---

<article class="spine reveal" style={`--d:${delay}ms`} data-slug={book.slug}>
  <div class="spine-img js-open">
    <Cover src={src} title={book.title} />
  </div>
  <h3 class="js-open">{book.title}</h3>
  <span class="label">
    {book.comingSoon ? 'Forthcoming' : `${book.pages ? `${book.pages} pp` : ''}${book.ku ? ' · KU' : ''}`}
  </span>
</article>
