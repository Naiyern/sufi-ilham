---
import { coverUrl } from '../data/site';
import type { Book } from '../data/site';
import Cover from './Cover.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { book: Book; delay?: number }
const { book, delay = 0 } = Astro.props;
const src = coverUrl(book.img, base);
---

<a
  class="spine reveal"
  style={`--d:${delay}ms`}
  href={`${base}/books/${book.slug}/`}
  data-slug={book.slug}
  aria-haspopup="dialog"
  aria-controls="modal"
  aria-label={`Open details for ${book.altTitle || book.title}`}
>
  <span class="spine-img">
    <Cover src={src} title={book.title} />
  </span>
  <h3 lang={book.language ?? 'en'} dir={book.dir ?? undefined}>{book.title}</h3>
  <span class="label">
    {book.comingSoon ? 'Forthcoming' : `${book.pages ? `${book.pages} pp` : ''}${book.ku ? ' · KU' : ''}`}
  </span>
</a>
