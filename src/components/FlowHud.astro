---
/* A fixed, decorative readout of the reader's passage through the existing
   scenes. It never occupies document flow and never creates a tab stop. */
---

<div class="flow-hud" id="flowHud" data-tone="paper" aria-hidden="true">
  <div class="flow-hud__count">
    <span data-flow-current>01</span>
    <span class="flow-hud__divider">/</span>
    <span data-flow-total>01</span>
  </div>
  <span class="flow-hud__label" data-flow-label>Opening</span>
  <div class="flow-hud__track">
    <i></i>
    <b></b>
  </div>
</div>
