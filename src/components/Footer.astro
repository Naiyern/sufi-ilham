---
import { site, books, seriesBooks } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const single = books.filter((b) => !b.series).slice(0, 8);
const cols = [
  { h: 'Books', items: single.map((b) => ({ label: b.title, href: `${base}/books/${b.slug}` })) },
  {
    h: 'Series',
    items: [
      ...seriesBooks('maple').slice(0, 2).map((b) => ({ label: b.title, href: `${base}/books/${b.slug}` })),
      { label: 'Maple Falls Romance', href: `${base}/#maple` },
      { label: 'The Tithe Crown', href: `${base}/#tithe` },
      { label: 'Cartographers of Lost Tomorrows', href: `${base}/#carto` },
      { label: 'The Song of the Unbroken Sky', href: `${base}/#song` },
    ],
  },
  {
    h: 'Explore',
    items: [
      { label: 'All Books', href: `${base}/#books` },
      { label: 'About the Author', href: `${base}/#about` },
      { label: 'Themes', href: `${base}/#themes` },
      { label: 'Contact', href: `${base}/#contact` },
      { label: 'Privacy Policy', href: `${base}/privacy` },
      { label: 'Terms of Use', href: `${base}/terms` },
      { label: 'Amazon Store', href: site.amazonUS },
    ],
  },
];
---

<footer>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-col">
        <a class="brand" href={`${base}/`} style="margin-bottom:1.1rem">
          <span class="brand-mark">S</span>
          <span class="brand-txt"><b>Sufi Ilham</b><span>Author</span></span>
        </a>
        <p style="font-size:.88rem;max-width:34ch">
          Books on belief, time, attention and the freedom that waits on the other side of conditioning.
          Available worldwide on Amazon in Kindle and paperback.
        </p>
        <p style="font-size:.84rem">
          <a href={`tel:+${site.phoneRaw}`}>☏ &nbsp;{site.phone}</a><br />
          <a href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">✆ &nbsp;WhatsApp</a><br />
          <a href={site.instagram} target="_blank" rel="noopener">◎ &nbsp;@Sufiilham07</a><br />
          ◈ &nbsp;{site.location}
        </p>
      </div>
      {cols.map((c) => (
        <div class="f-col">
          <h4>{c.h}</h4>
          <ul>{c.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="f-bot">
      <span>© {new Date().getFullYear()} Sufi Ilham (MD Naiyer Alam). All rights reserved.</span>
      <span><a href={`${base}/privacy`}>Privacy</a> · <a href={`${base}/terms`}>Terms</a></span>
    </div>
  </div>
</footer>
