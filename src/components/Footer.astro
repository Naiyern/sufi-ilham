---
import { site, books, series } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const single = books.filter((b) => !b.series).slice(0, 8);
---

<footer class="colophon">
  <div class="wrap">
    <div class="colo-grid">
      <div class="colo">
        <a class="logo" href={`${base}/`} style="margin-bottom:1rem">
          <b>Sufi Ilham</b><span class="est">MD Naiyer Alam</span>
        </a>
        <p style="font-size:.9rem;max-width:36ch">
          Books on belief, time, attention and the freedom that waits on the other side of conditioning.
          Available worldwide on Amazon in Kindle and paperback.
        </p>
        <p class="note" style="margin-top:1.2rem">
          <a href={`tel:+${site.phoneRaw}`}>{site.phone}</a><br />
          <a href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">WhatsApp</a> ·
          <a href={site.instagram} target="_blank" rel="noopener">@Sufiilham07</a><br />
          {site.location}
        </p>
      </div>

      <div class="colo">
        <h4>Selected works</h4>
        <ul>{single.map((b) => <li><a href={`${base}/books/${b.slug}`}>{b.title}</a></li>)}</ul>
      </div>

      <div class="colo">
        <h4>Series</h4>
        <ul>
          {series.map((s) => <li><a href={`${base}/series/${s.id}`}>{s.name}</a></li>)}
        </ul>
      </div>

      <div class="colo">
        <h4>Explore</h4>
        <ul>
          <li><a href={`${base}/#index`}>The index</a></li>
          <li><a href={`${base}/#essay`}>The author</a></li>
          <li><a href={`${base}/#figures`}>Themes</a></li>
          <li><a href={`${base}/contact`}>Enquiries</a></li>
          <li><a href={`${base}/rss.xml`}>RSS feed</a></li>
          <li><a href={site.amazonUS} target="_blank" rel="noopener">Amazon store</a></li>
          <li><a href={`${base}/privacy`}>Privacy</a></li>
          <li><a href={`${base}/terms`}>Terms</a></li>
        </ul>
      </div>
    </div>

    <div class="colo-bot">
      <span>© {new Date().getFullYear()} Sufi Ilham · All rights reserved</span>
      <span>Set in Instrument Serif, Newsreader &amp; IBM Plex Mono</span>
    </div>
  </div>
</footer>
