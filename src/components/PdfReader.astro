---
/* Renders a PDF inline with PDF.js (canvas), so it works everywhere —
   including sandboxed/cross-origin previews where Chrome blocks the native
   PDF plugin inside an <iframe>. PDF.js is self-hosted (no CDN dependency).
   Falls back to open-in-tab / download links. */
interface Props {
  src: string;
  title: string;
  download?: string;
  cls?: string;
}
const { src, title, download, cls = '' } = Astro.props;
const dl = download ?? src;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lib = `${base}/vendor/pdfjs/pdf.min.js`;
const worker = `${base}/vendor/pdfjs/pdf.worker.min.js`;
---

<div
  class={`pdfjs ${cls}`}
  data-pdf={src}
  data-lib={lib}
  data-worker={worker}
  role="region"
  aria-label={`${title} — reader`}
>
  <div class="pdfjs-pages"></div>
  <p class="pdfjs-status" role="status">Loading the book…</p>
  <p class="pdfjs-fallback" hidden>
    Couldn’t display the book here.
    <a href={src} target="_blank" rel="noopener">Open it in a new tab</a> or
    <a href={dl} download>download the PDF</a>.
  </p>
  <noscript>
    <p>Your browser has JavaScript disabled.
      <a href={src} target="_blank" rel="noopener">Open the PDF</a> or
      <a href={dl} download>download it</a>.</p>
  </noscript>
</div>

<script is:inline>
  (function () {
    async function boot(el) {
      if (el.dataset.booted) return;
      el.dataset.booted = '1';
      var url = el.getAttribute('data-pdf');
      var pagesEl = el.querySelector('.pdfjs-pages');
      var statusEl = el.querySelector('.pdfjs-status');
      var fallbackEl = el.querySelector('.pdfjs-fallback');
      try {
        var lib = await import(el.getAttribute('data-lib'));
        lib.GlobalWorkerOptions.workerSrc = el.getAttribute('data-worker');
        var pdf = await lib.getDocument({ url: url }).promise;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        for (var n = 1; n <= pdf.numPages; n++) {
          var page = await pdf.getPage(n);
          var vp1 = page.getViewport({ scale: 1 });
          var avail = (pagesEl.clientWidth || el.clientWidth || 800);
          var scale = Math.min(2, Math.max(0.4, avail / vp1.width));
          var viewport = page.getViewport({ scale: scale * dpr });
          var canvas = document.createElement('canvas');
          canvas.className = 'pdfjs-page';
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          canvas.style.width = '100%';
          canvas.style.height = 'auto';
          canvas.setAttribute('aria-label', 'Page ' + n);
          pagesEl.appendChild(canvas);
          await page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise;
          if (n === 1 && statusEl) statusEl.hidden = true;
        }
        if (statusEl) statusEl.hidden = true;
      } catch (err) {
        if (statusEl) statusEl.hidden = true;
        if (fallbackEl) fallbackEl.hidden = false;
      }
    }

    var els = document.querySelectorAll('.pdfjs');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { io.unobserve(e.target); boot(e.target); }
        });
      }, { rootMargin: '400px' });
      els.forEach(function (el) { io.observe(el); });
    } else {
      els.forEach(boot);
    }
  })();
</script>

