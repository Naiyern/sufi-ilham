---
import i18n from '../data/i18n.json';
const langs = Object.entries(i18n as Record<string, any>).map(([code, d]) => ({
  code,
  name: d._name as string,
  note: { en: 'English', hi: 'Hindi', ur: 'Urdu', hinglish: 'Roman Hindi' }[code] ?? '',
  short: { en: 'EN', hi: 'हि', ur: 'اُر', hinglish: 'HI-R' }[code] ?? code.toUpperCase(),
}));
---

<span class="lang-wrap">
  <button class="lang-btn" id="langBtn" type="button" aria-label="Change language" aria-expanded="false">
    <span class="lang-cur">EN</span>
  </button>

  <div class="lang-menu" id="langMenu" role="menu">
    <span class="lang-head">Language</span>
    {langs.map((l) => (
      <button class={`lang-opt${l.code === 'en' ? ' on' : ''}`} data-lang={l.code} data-short={l.short} type="button" role="menuitem">
        <span class="lang-nm" lang={l.code === 'hinglish' ? 'hi-Latn' : l.code}>{l.name}</span>
        <span class="lang-note">{l.note}</span>
        <span class="tick" aria-hidden="true">✓</span>
      </button>
    ))}
  </div>
</span>
