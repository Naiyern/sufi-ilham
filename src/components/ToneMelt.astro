---
/* A decorative bridge between editorial scenes. Keeping the melt outside the
   content sections means text never sits on an uncertain contrast background. */
type Tone = 'ink' | 'paper' | 'clay' | 'ember';
interface Props {
  from?: Tone;
  to?: Tone;
  shelf?: boolean;
}

const tones: Record<Tone, string> = {
  ink: 'var(--stage-ink)',
  paper: 'var(--paper)',
  clay: 'var(--stage-clay)',
  ember: 'var(--stage-ember)',
};
const { from, to = 'paper', shelf = false } = Astro.props;
const resolvedFrom: Tone = from ?? (to === 'paper' ? 'ink' : 'paper');
---

<div
  class={`tone-melt${shelf ? ' tone-melt--shelf' : ''}`}
  data-tone-melt
  data-from={resolvedFrom}
  data-to={to}
  style={`--melt-from:${tones[resolvedFrom]};--melt-to:${tones[to]}`}
  aria-hidden="true"
></div>
