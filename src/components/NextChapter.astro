---
import { readingPaths } from '../data/reading-paths';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="next-chapter" aria-labelledby="next-chapter-title">
  <div class="wrap">
    <div class="next-chapter-heading">
      <div>
        <span class="next-chapter-label">THE ARCHIVE IS OPEN / KEEP EXPLORING</span>
        <h2 id="next-chapter-title">There’s always<br /><em>another beginning.</em></h2>
      </div>
      <p>Find a new question, step into another world, or follow the story that speaks to you.</p>
    </div>
    <nav class="next-chapter-paths" aria-label="Explore reading paths">
      {readingPaths.map((path) => (
        <a href={`${base}/discover/#path-${path.number}`}>
          <span class="next-path-number">{path.number} / {path.eyebrow}</span>
          <strong>{path.title}</strong>
          <span class="next-path-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <div class="next-chapter-bottom">
      <a href={`${base}/discover/`}>Explore the reader’s guide <span aria-hidden="true">↗</span></a>
      <a href={`${base}/#index`}>Browse the complete archive <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
