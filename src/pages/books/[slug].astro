---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import { books, site, seriesBooks, type Book, coverUrl, pdfUrl, byNewest, isNewRelease, formatPublished } from '../../data/site';

type Reader = { slug: string; chapters: { id: string; title: string }[]; source?: string };
const readerFiles = import.meta.glob<Reader>('../../data/reader/*.json', { eager: true, import: 'default' });
const readers: Record<string, Reader> = {};
for (const mod of Object.values(readerFiles)) readers[mod.slug] = mod;

export function getStaticPaths() {
  return books.map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { book } = Astro.props as { book: Book };
const img = coverUrl(book.img, base);
const plain = (book.desc ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const pdf = book.free && book.pdf ? pdfUrl(book.pdf, base) : '';
const readUrl = book.free ? `${base}/read/${book.slug}/` : '';
const reader = book.free ? readers[book.slug] : undefined;
const chapters = reader?.chapters ?? [];

const stores: [string, string | undefined][] = [
  ['Amazon.com', book.us], ['Amazon.in', book.in], ['Amazon UK', book.uk],
  ['Amazon CA', book.ca], ['Amazon AU', book.au], ['Paperback', book.paperback],
];

const sameShelf = (book.series ? seriesBooks(book.series) : books.filter((b) => b.genre === book.genre))
  .filter((b) => b.slug !== book.slug && !b.comingSoon);
const related = (sameShelf.length ? sameShelf : byNewest.filter((b) => b.slug !== book.slug)).slice(0, 4);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: book.title,
    author: { '@type': 'Person', name: site.name, alternateName: site.altName },
    description: plain.slice(0, 400),
    numberOfPages: book.pages ?? undefined,
    ...(book.published && book.published.length > 7 ? { datePublished: book.published } : {}),
    inLanguage: 'en',
    // structured data wants a fetchable URL, so inline data: placeholders are omitted
    ...(book.img.startsWith('data:') ? {} : { image: coverUrl(book.img, site.url) }),
    url: book.us,
  },
];
---

<Base title={`${book.title} — Sufi Ilham`} description={plain.slice(0, 180)} type="book" jsonld={jsonld}>
  <div class="bp-bar" id="bpBar"></div>
  <section style="padding-top:9rem" id="bookBody">
    <div class="wrap">
      <p class="crumb">
        <a href={`${base}/`}>Home</a> · <a href={`${base}/#index`}>Books</a> · {book.title}
      </p>

      <div class="bp-grid" style="margin-top:2rem">
        <div class="reveal in">
          <img class="bp-cover" src={img} alt={`${book.title} cover`} width="400" height="600" />
          {book.free ? (
            <>
              <div class="buy-row">
                <a class="btn pri" href={readUrl}>Read free online →</a>
                {pdf && <a class="btn" href={pdf} download>Download PDF</a>}
              </div>
              <p class="free-note">100% free — no sign-up, no payment. Read the full book in your browser (original Nastaliq pages, night mode, page-jump) or download your own copy.</p>
            </>
          ) : (
            <div class="buy-row">
              {stores.filter(([, u]) => u).map(([l, u], i) => (
                <a class={`btn${i === 0 ? ' pri' : ''}`} href={u} target="_blank" rel="noopener">{l}</a>
              ))}
            </div>
          )}
        </div>

        <div class="reveal in">
          {book.free
            ? <span class="label mark">Free to read · {formatPublished(book.published)}</span>
            : isNewRelease(book) && <span class="label mark">New release · {formatPublished(book.published)}</span>}
          {book.kicker && <span class="label">{book.kicker}</span>}
          <h1 dir={book.dir ?? undefined} style="font-size:clamp(2.1rem,5vw,3.6rem)">{book.title}</h1>
          {book.sub && <p style="font-family:var(--display);font-style:italic;font-size:1.25rem;margin-top:.6rem;color:var(--ink-2)">{book.sub}</p>}
          {book.quote && <p class="pull" dir={book.dir ?? undefined}>{book.quote}</p>}
          <ul class="specs" style="margin:1.6rem 0">
            {(book.spec ?? []).map((s) => <li>{s}</li>)}
          </ul>
          <div class="desc" set:html={book.desc} />
        </div>
      </div>

      {book.free && (
        <section id="reader" class="reader-block reveal">
          <div class="reader-head">
            <div>
              <span class="label mark">Read free online</span>
              <h2 dir={book.dir ?? undefined} style="margin:.3rem 0 0">{book.title}</h2>
            </div>
            <div class="reader-actions">
              <a class="btn pri" href={readUrl}>Start reading →</a>
              {pdf && <a class="btn" href={pdf} download>Download PDF</a>}
            </div>
          </div>
          <p style="color:var(--ink-2);max-width:52ch">Read the complete book right in your browser — the original pages with their beautiful Nastaliq typography, with light, sepia and night modes, adjustable page width, page-jump and a saved reading position. Or download the PDF to keep.</p>
          {chapters.length > 0 && (
            <ol class="chap-list">
              {chapters.map((c, i) => (
                <li>
                  <a href={`${readUrl}#${c.id}`}>
                    <span class="chap-n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="chap-t" dir={book.dir ?? undefined}>{c.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      )}

      {book.series && (
        <p style="margin-top:2.6rem">
          <a class="btn" href={`${base}/series/${book.series}/`}>View the full series →</a>
        </p>
      )}

      {related.length > 0 && (
        <div style="margin-top:6rem">
          <span class="label mark">Keep reading</span>
          <h2>{book.series ? 'More in this series' : 'You may also like'}</h2>
          <div class="shelf-scroll" style="margin-top:1.6rem">
            {related.map((b, i) => <BookCard book={b} delay={i * 70} />)}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
