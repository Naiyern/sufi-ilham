---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import AnimatedCover from '../../components/AnimatedCover.astro';
import Cover from '../../components/Cover.astro';
import { books, series, site, seriesBooks, type Book, coverUrl, byNewest, isNewRelease, formatPublished } from '../../data/site';

type Reader = { slug: string; chapters: { id: string; title: string }[]; source?: string };
const readerFiles = import.meta.glob<Reader>('../../data/reader/*.json', { eager: true, import: 'default' });
const readers: Record<string, Reader> = {};
for (const mod of Object.values(readerFiles)) readers[mod.slug] = mod;

export function getStaticPaths() {
  return books.map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { book } = Astro.props as { book: Book };
const img = coverUrl(book.img, base);
const coverArt = book.coverArt ? coverUrl(book.coverArt, base) : '';
const socialImage = book.coverArt
  ? coverUrl(book.coverArt, site.url)
  : book.img.startsWith('data:') ? undefined : coverUrl(book.img, site.url);
const plain = (book.desc ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const readUrl = book.free ? `${base}/read/${book.slug}/` : '';
const reader = book.free ? readers[book.slug] : undefined;
const chapters = reader?.chapters ?? [];
const seriesInfo = book.series ? series.find((item) => item.id === book.series) : undefined;
const bookAccent = seriesInfo?.accent ?? '#df6348';
// Covers in the catalogue are trusted, and the same image is already used in
// the foreground. Reuse it as a subdued atmospheric backdrop on every book.
const bookHeroStyle = `--accent:${bookAccent};--cinema-still:url("${img.replace(/["\\]/g, '')}")`;

const stores: [string, string | undefined][] = [
  ['Amazon.com', book.us], ['Amazon.in', book.in], ['Amazon UK', book.uk],
  ['Amazon CA', book.ca], ['Amazon AU', book.au], ['Paperback', book.paperback],
];
const availableStores = stores.filter(([, url]) => Boolean(url));
const sameShelf = (book.series ? seriesBooks(book.series) : books.filter((b) => b.genre === book.genre))
  .filter((b) => b.slug !== book.slug && !b.comingSoon);
const related = (sameShelf.length ? sameShelf : byNewest.filter((b) => b.slug !== book.slug)).slice(0, 4);
const orderList = book.series ? seriesBooks(book.series) : [];
const orderIndex = orderList.findIndex((item) => item.slug === book.slug);
const previousBook = orderIndex > 0 ? orderList[orderIndex - 1] : undefined;
const nextBook = orderIndex >= 0 ? orderList[orderIndex + 1] : undefined;
const status = book.comingSoon ? 'Forthcoming' : book.free ? 'Read free online' : isNewRelease(book) ? 'New release' : 'Available now';

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: book.title,
    author: { '@type': 'Person', name: site.name, alternateName: site.altName },
    description: plain.slice(0, 400),
    numberOfPages: book.pages ?? undefined,
    ...(book.published && book.published.length > 7 ? { datePublished: book.published } : {}),
    inLanguage: book.language ?? 'en',
    ...(socialImage ? { image: socialImage } : {}),
    url: `${site.url}/books/${book.slug}/`,
  },
];
---

<Base title={`${book.title} — Sufi Ilham`} description={plain.slice(0, 180)} image={socialImage} type="book" jsonld={jsonld}>
  <div class="bp-bar" id="bpBar"></div>
  <div id="bookBody">
    <header class="book-hero" style={bookHeroStyle}>
      <div class="wrap">
        <p class="crumb book-crumb">
          <a href={`${base}/`}>Home</a><span aria-hidden="true">/</span>
          <a href={`${base}/#index`}>The archive</a><span aria-hidden="true">/</span>
          <span aria-current="page">{book.altTitle || book.title}</span>
        </p>

        <div class="book-hero-grid">
          <figure class="book-hero-art">
            <div class="book-cover-mat">
              {coverArt ? (
                <AnimatedCover
                  art={coverArt}
                  title={book.title}
                  roman={book.altTitle}
                  tagline="A Part of the River"
                  author="صوفی الہام"
                  authorRoman="Sufi Ilham"
                  note="Free Urdu Novella"
                  dir={book.dir ?? 'rtl'}
                  cls="book-cover-live"
                />
              ) : (
                <Cover src={img} title={book.title} eager cls="book-cover-static" />
              )}
            </div>
            <figcaption>
              <span>{book.altTitle || book.title}</span>
              <span>{book.pages ? `${book.pages} pages` : 'The archive'}</span>
            </figcaption>
          </figure>

          <div class="book-hero-copy">
            <div class="book-status-line">
              <span class="book-status-dot" aria-hidden="true"></span>
              <span>{status}</span>
              {book.published && <span class="book-published">{formatPublished(book.published)}</span>}
            </div>
            {book.series && seriesInfo && (
              <a class="book-series-link" href={`${base}/series/${book.series}/`}>{seriesInfo.name}<span aria-hidden="true">↗</span></a>
            )}
            {book.kicker && <p class="book-kicker">{book.kicker}</p>}
            <h1 lang={book.language ?? 'en'} dir={book.dir ?? undefined}>{book.title}</h1>
            {book.altTitle && <p class="book-alt-title">{book.altTitle}</p>}
            {book.sub && <p class="book-subtitle" lang={book.language ?? 'en'} dir={book.dir ?? undefined}>{book.sub}</p>}
            {book.quote && <blockquote class="book-quote" lang={book.language ?? 'en'} dir={book.dir ?? undefined}>{book.quote}</blockquote>}

            <div class="book-hero-facts" aria-label="Book details">
              {book.pages && <div><strong>{book.pages}</strong><span>Pages</span></div>}
              {book.ku && <div><strong>KU</strong><span>Included</span></div>}
              {book.free && <div><strong>Free</strong><span>To read</span></div>}
              {book.comingSoon && <div><strong>Next</strong><span>Forthcoming</span></div>}
            </div>

            <div class="book-hero-actions">
              {book.free && <a class="btn solid" href={readUrl}>Read free online <span aria-hidden="true">→</span></a>}
              {book.us && <a class={`btn${book.free ? '' : ' solid'}`} href={book.us} target="_blank" rel="noopener">Amazon.com <span aria-hidden="true">↗</span></a>}
              {book.in && <a class="btn" href={book.in} target="_blank" rel="noopener">Amazon.in <span aria-hidden="true">↗</span></a>}
              <a class="book-scroll-link" href="#about">About this book <span aria-hidden="true">↓</span></a>
            </div>
            {book.free && <p class="book-reader-note">No payment or sign-up required to read online.</p>}
            {book.comingSoon && !book.us && <p class="book-reader-note">This title is listed as forthcoming; availability will be added when published.</p>}
          </div>
        </div>
      </div>
    </header>

    <section class="book-content" id="about">
      <div class="wrap">
        <div class="book-description-grid">
          <aside class="book-brief">
            <span class="label mark">A closer look</span>
            <h2>{book.genre === 'self-help' || book.genre === 'philosophy' ? 'Inside the book' : 'The story'}</h2>
            <ul class="specs">{(book.spec ?? []).map((item) => <li>{item}</li>)}</ul>
            {book.series && <a class="btn book-series-button" href={`${base}/series/${book.series}/`}>Explore the series <span aria-hidden="true">→</span></a>}
          </aside>
          <article class="desc book-description reveal in" set:html={book.desc} />
        </div>

        {book.free && (
          <section id="reader" class="reader-block book-reader">
            <div class="reader-head">
              <div>
                <span class="label mark">Read free online</span>
                <h2 dir={book.dir ?? undefined} style="margin:.3rem 0 0">{book.title}</h2>
              </div>
              <div class="reader-actions"><a class="btn solid" href={readUrl}>Start reading <span aria-hidden="true">→</span></a></div>
            </div>
            <p class="reader-intro">Read the complete book in your browser, with its original page design, reading preferences and saved position.</p>
            {chapters.length > 0 && (
              <ol class="chap-list">
                {chapters.map((chapter, index) => (
                  <li>
                    <a href={`${readUrl}#${chapter.id}`}>
                      <span class="chap-n">{String(index + 1).padStart(2, '0')}</span>
                      <span class="chap-t" dir={book.dir ?? undefined}>{chapter.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </section>
        )}

        {availableStores.length > 0 && (
          <section class="edition-section" id="editions" aria-labelledby="edition-title">
            <div class="edition-heading">
              <div><span class="label mark">Find your edition</span><h2 id="edition-title">Choose a store</h2></div>
              <p>Store availability and pricing are shown by the retailer.</p>
            </div>
            <div class="edition-links">
              {availableStores.map(([label, url]) => (
                <a class="edition-link" href={url} target="_blank" rel="noopener">
                  <span>{label}</span><span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {(previousBook || nextBook) && (
          <nav class="book-order-nav" aria-label="Series reading order">
            <div><span class="label mark">Reading order</span><h2>Continue the journey.</h2></div>
            <div class="book-order-links">
              {previousBook && <a href={`${base}/books/${previousBook.slug}/`}><span>← Previous book</span><strong>{previousBook.title}</strong></a>}
              {nextBook && <a href={`${base}/books/${nextBook.slug}/`}><span>Next book →</span><strong>{nextBook.title}{nextBook.comingSoon ? ' · Forthcoming' : ''}</strong></a>}
            </div>
          </nav>
        )}

        {related.length > 0 && (
          <section class="related-section" aria-labelledby="related-title">
            <div class="folio">
              <h2 id="related-title">{book.series && sameShelf.length ? 'Continue the series' : 'More from the archive'}</h2>
              <span class="label">Keep reading →</span>
            </div>
            <div class="shelf-scroll">
              {related.map((relatedBook, index) => <BookCard book={relatedBook} delay={index * 70} />)}
            </div>
          </section>
        )}
      </div>
    </section>
  </div>
</Base>
