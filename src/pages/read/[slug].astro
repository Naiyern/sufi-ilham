---
import '@fontsource/noto-nastaliq-urdu/400.css';
import '@fontsource/noto-nastaliq-urdu/700.css';
import { books, type Book, pdfUrl } from '../../data/site';

type Reader = {
  slug: string; title: string; author?: string; sub?: string;
  dir?: 'rtl' | 'ltr'; lang?: string; source?: string;
  chapters: { id: string; title: string; html: string }[];
};

const readerFiles = import.meta.glob<Reader>('../../data/reader/*.json', { eager: true, import: 'default' });
const readers: Record<string, Reader> = {};
for (const mod of Object.values(readerFiles)) readers[mod.slug] = mod;

export function getStaticPaths() {
  // Reader exists for every free book (uses extracted chapters when available).
  return books.filter((b) => b.free).map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { book } = Astro.props as { book: Book };
const reader = readers[book.slug];
const pdf = book.pdf ? pdfUrl(book.pdf, base) : '';
const backUrl = `${base}/books/${book.slug}/`;
const dir = reader?.dir ?? book.dir ?? 'ltr';
const lang = reader?.lang ?? (dir === 'rtl' ? 'ur' : 'en');
const isPlaceholder = reader?.source === 'placeholder-sample';
const chapters = reader?.chapters ?? [];

/* Per-book artwork. Chapter plates cycle over this list, so it decorates any
   number of extracted chapters without touching the text pipeline. */
const artBooks: Record<string, { hero?: string; plates: string[] }> = {
  'darya-ka-aik-hissa': {
    hero: 'images/darya/hero.jpg',
    plates: ['images/darya/ch1.jpg', 'images/darya/ch2.jpg', 'images/darya/ch3.jpg'],
  },
};
const art = artBooks[book.slug];
const heroUrl = art?.hero ? `${base}/${art.hero}` : '';
const plate = (i: number) =>
  art && art.plates.length ? `${base}/${art.plates[i % art.plates.length]}` : '';

---

<!doctype html>
<html lang={lang} dir={dir} data-rtheme="sepia">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{book.title} — Read free · Sufi Ilham</title>
    <meta name="description" content={`Read ${book.title} by Sufi Ilham free online.`} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <style is:inline>
      :root { --rf: 1.25rem; --rlh: 2.15; --rmw: 44rem; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { min-height: 100vh; transition: background .25s, color .25s; }
      html[data-rtheme="light"] body { background: #f7f5ef; color: #1c1a15; }
      html[data-rtheme="sepia"] body { background: #ece3d0; color: #40372a; }
      html[data-rtheme="dark"]  body { background: #14140f; color: #d8d2c4; }

      .rprogress { position: fixed; inset: 0 auto auto 0; height: 3px; width: 100%;
        transform: scaleX(var(--p,0)); transform-origin: left; background: #c99a3f; z-index: 50; }
      html[dir="rtl"] .rprogress { transform-origin: right; }

      .rtop { position: sticky; top: 0; z-index: 40; display: flex; align-items: center;
        gap: .5rem; padding: .55rem clamp(.6rem, 3vw, 1.2rem);
        backdrop-filter: blur(8px); border-bottom: 1px solid rgba(120,110,90,.25); }
      html[data-rtheme="light"] .rtop { background: rgba(247,245,239,.85); }
      html[data-rtheme="sepia"] .rtop { background: rgba(236,227,208,.85); }
      html[data-rtheme="dark"]  .rtop { background: rgba(20,20,15,.85); }
      .rtop .sp { margin-inline-start: auto; }
      .rttl { font: 600 .95rem/1.2 var(--display, Georgia, serif); white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis; max-width: 42vw; }

      .ricon { display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
        min-width: 2.1rem; height: 2.1rem; padding: 0 .6rem; cursor: pointer;
        border: 1px solid rgba(120,110,90,.35); border-radius: 7px; background: transparent;
        color: inherit; font: 500 .8rem/1 system-ui, sans-serif; text-decoration: none; }
      .ricon:hover { border-color: #c99a3f; }
      .ricon.pri { background: #c99a3f; border-color: #c99a3f; color: #241c08; font-weight: 700; }

      .rpanel { position: fixed; z-index: 45; top: 3.4rem;
        border: 1px solid rgba(120,110,90,.35); border-radius: 10px; padding: .9rem;
        box-shadow: 0 18px 50px rgba(0,0,0,.35); display: none; min-width: 240px; }
      html[data-rtheme="light"] .rpanel { background: #fffdf7; }
      html[data-rtheme="sepia"] .rpanel { background: #f3ecdd; }
      html[data-rtheme="dark"]  .rpanel { background: #1e1e17; }
      .rpanel.open { display: block; }
      #rsettings { inset-inline-end: clamp(.6rem, 3vw, 1.2rem); }
      #rtoc { inset-inline-start: clamp(.6rem, 3vw, 1.2rem); max-height: 70vh; overflow: auto; max-width: min(88vw, 340px); }
      .rrow { display: flex; align-items: center; gap: .5rem; margin: .35rem 0 .8rem; }
      .rrow > span { font: 600 .7rem/1 system-ui; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
      .rseg { display: flex; gap: .3rem; flex-wrap: wrap; }
      .rseg button { flex: 1 1 auto; padding: .45rem .5rem; border: 1px solid rgba(120,110,90,.35);
        border-radius: 6px; background: transparent; color: inherit; cursor: pointer; font: 500 .8rem/1 system-ui; }
      .rseg button[aria-pressed="true"] { background: #c99a3f; border-color: #c99a3f; color: #241c08; font-weight: 700; }
      #rtoc ol { list-style: none; margin: .4rem 0 0; padding: 0; counter-reset: c; }
      #rtoc a { display: block; padding: .5rem .55rem; border-radius: 6px; text-decoration: none;
        color: inherit; font-size: .9rem; border: 1px solid transparent; }
      #rtoc a:hover { border-color: rgba(120,110,90,.35); }
      #rtoc a b { opacity: .55; margin-inline-end: .4rem; font-variant-numeric: tabular-nums; }

      main.rbook { max-width: var(--rmw); margin: 0 auto; padding: clamp(1.6rem, 5vw, 3.4rem) clamp(1.1rem, 5vw, 2rem) 30vh; }
      .rbanner { margin: 0 0 2rem; padding: .7rem .9rem; border-radius: 8px; font-size: .82rem;
        border: 1px dashed #c99a3f; background: rgba(201,154,63,.12); }
      .rhead { text-align: center; margin: 1rem 0 3.2rem; }
      .rhead h1 { font: 700 clamp(2rem, 6vw, 3rem)/1.5 "Noto Nastaliq Urdu", var(--display, serif); margin: 0; }
      .rhead .rauthor { margin-top: 1rem; font-size: 1.1rem; opacity: .8; }
      .rchap { margin: 0 0 3.5rem; scroll-margin-top: 4rem; }
      .rchap h2 { font: 700 clamp(1.4rem, 4vw, 2rem)/1.7 "Noto Nastaliq Urdu", var(--display, serif);
        text-align: center; margin: 0 0 1.8rem; padding-bottom: 1rem;
        border-bottom: 1px solid rgba(120,110,90,.25); }
      .rchap p { font-size: var(--rf); line-height: var(--rlh); margin: 0 0 1.3rem; text-align: justify; }
      html[lang="ur"] .rchap p, html[dir="rtl"] .rchap p {
        font-family: "Noto Nastaliq Urdu", serif; text-align: right; }
      html[lang="ur"] .rchap { font-feature-settings: "kern" 1; }
      .rempty { text-align: center; opacity: .8; padding: 4rem 0; }
      .rempty a { color: #c99a3f; }

      /* ---- visuals ---- */
      .rhero { position: relative; width: 100%; max-width: 1100px; margin: 0 auto;
        aspect-ratio: 21 / 9; overflow: hidden; }
      .rhero img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.96); }
      .rhero::after { content: ""; position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 40%, var(--rbg, #ece3d0) 100%); }
      html[data-rtheme="light"] { --rbg: #f7f5ef; }
      html[data-rtheme="sepia"] { --rbg: #ece3d0; }
      html[data-rtheme="dark"]  { --rbg: #14140f; }

      .rchap .plate { margin: 0 0 2rem; border-radius: 10px; overflow: hidden;
        box-shadow: 0 14px 40px rgba(0,0,0,.28); }
      .rchap .plate img { width: 100%; height: auto; display: block; }

      .ornament { display: block; margin: 1.4rem auto 2rem; width: 132px; height: auto; color: #c99a3f; opacity: .9; }
      .ornament.top { margin: 0 auto 1.4rem; }

      /* Drop cap only for LTR — Urdu letters are connected, so a floated first
         letter would break the ligature; RTL gets an ornamental opener instead. */
      html[dir="ltr"] .rchap > div > p:first-of-type::first-letter {
        float: left; font-family: var(--display, Georgia, serif); font-weight: 700;
        font-size: 3.4em; line-height: .78; padding: .05em .12em 0 0; color: #b9822f; }
      html[dir="rtl"] .rchap > div > p:first-of-type { font-size: calc(var(--rf) * 1.04); }
      html[dir="rtl"] .rchap > div > p:first-of-type::before {
        content: "﴾"; color: #c99a3f; margin-inline-end: .35rem; font-size: 1.3em; vertical-align: -.05em; }

      @media (max-width: 640px) { .rttl { max-width: 34vw; } .ricon span.lbl { display: none; } }
      @media print { .rtop, .rprogress, .rpanel { display: none !important; } }
    </style>
  </head>
  <body>
    <div class="rprogress" id="rprogress"></div>

    <header class="rtop">
      <a class="ricon" href={backUrl} aria-label="Back to book page">←<span class="lbl"> Back</span></a>
      {chapters.length > 0 && (
        <button class="ricon" id="rtocBtn" aria-haspopup="true" aria-expanded="false">☰<span class="lbl"> Contents</span></button>
      )}
      <span class="rttl" dir={dir}>{book.title}</span>
      <button class="ricon sp" id="rsetBtn" aria-haspopup="true" aria-expanded="false">Aa</button>
      {pdf && <a class="ricon pri" href={pdf} download>Download<span class="lbl"> PDF</span></a>}
    </header>

    {chapters.length > 0 && (
      <nav class="rpanel" id="rtoc" aria-label="Table of contents">
        <div class="rrow"><span>Contents</span></div>
        <ol>
          {chapters.map((c, i) => (
            <li><a href={`#${c.id}`} data-goto={c.id}><b>{String(i + 1).padStart(2, '0')}</b>{c.title}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="rpanel" id="rsettings" aria-label="Reading settings">
      <div class="rrow"><span>Theme</span></div>
      <div class="rseg" data-set="theme">
        <button data-val="light">Light</button>
        <button data-val="sepia">Sepia</button>
        <button data-val="dark">Night</button>
      </div>
      <div class="rrow"><span>Text size</span></div>
      <div class="rseg" data-set="font">
        <button data-val="down" aria-label="Smaller text">A−</button>
        <button data-val="reset">Reset</button>
        <button data-val="up" aria-label="Larger text">A+</button>
      </div>
      <div class="rrow"><span>Line spacing</span></div>
      <div class="rseg" data-set="lh">
        <button data-val="tight">Tight</button>
        <button data-val="normal">Normal</button>
        <button data-val="airy">Airy</button>
      </div>
    </div>

    {heroUrl && (
      <div class="rhero">
        <img src={heroUrl} alt="" width="1100" height="471" fetchpriority="high" />
      </div>
    )}

    <main class="rbook" id="rbook">
      {isPlaceholder && (
        <p class="rbanner">Sample preview — this is placeholder text. Add the real manuscript PDF and it will be replaced automatically by your book’s own words.</p>
      )}
      <div class="rhead">
        <h1 dir={dir}>{book.title}</h1>
        {reader?.author && <p class="rauthor" dir={dir}>{reader.author}</p>}
        <svg class="ornament" viewBox="0 0 240 24" fill="none" aria-hidden="true">
          <path d="M12 12h72" stroke="currentColor" stroke-width="1.2"/>
          <path d="M156 12h72" stroke="currentColor" stroke-width="1.2"/>
          <path d="M96 12c6-7 12-7 12 0 0-7 6-7 12 0 6 7 12 7 12 0 0 7 6 7 12 0" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="120" cy="12" r="2.4" fill="currentColor"/>
        </svg>
      </div>

      {chapters.length > 0 ? (
        chapters.map((c, i) => (
          <section class="rchap" id={c.id}>
            {plate(i) && (
              <figure class="plate"><img src={plate(i)} alt="" width="880" height="440" loading="lazy" /></figure>
            )}
            {c.title && <h2 dir={dir}>{c.title}</h2>}
            <svg class="ornament top" viewBox="0 0 240 24" fill="none" aria-hidden="true">
              <path d="M40 12h56" stroke="currentColor" stroke-width="1.1"/>
              <path d="M144 12h56" stroke="currentColor" stroke-width="1.1"/>
              <path d="M104 12c4-6 8-6 8 0 0-6 4-6 8 0 4 6 8 6 8 0 0-6 4-6 8 0" stroke="currentColor" stroke-width="1.3"/>
            </svg>
            <div set:html={c.html} />
          </section>
        ))
      ) : (
        <div class="rempty">
          <p>The reading text for this book hasn’t been added yet.</p>
          {pdf && <p>You can still <a href={pdf} download>download the PDF</a> or <a href={pdf} target="_blank" rel="noopener">open it in a new tab</a>.</p>}
        </div>
      )}
    </main>

    <script is:inline define:vars={{ slug: book.slug }}>
      (function () {
        var html = document.documentElement;
        var K = 'reader:' + slug;
        var KG = 'reader:prefs';
        var prefs = { theme: 'sepia', font: 1.25, lh: 2.15 };
        try { Object.assign(prefs, JSON.parse(localStorage.getItem(KG) || '{}')); } catch (e) {}

        function apply() {
          html.setAttribute('data-rtheme', prefs.theme);
          html.style.setProperty('--rf', prefs.font + 'rem');
          html.style.setProperty('--rlh', prefs.lh);
          document.querySelectorAll('[data-set="theme"] button').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.val === prefs.theme));
          });
          var lhName = prefs.lh <= 1.8 ? 'tight' : prefs.lh >= 2.4 ? 'airy' : 'normal';
          document.querySelectorAll('[data-set="lh"] button').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.val === lhName));
          });
          try { localStorage.setItem(KG, JSON.stringify(prefs)); } catch (e) {}
        }
        apply();

        // Panels (settings + TOC), mutually exclusive.
        function panel(btn, box) {
          if (!btn || !box) return;
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = box.classList.toggle('open');
            btn.setAttribute('aria-expanded', String(open));
            document.querySelectorAll('.rpanel').forEach(function (p) { if (p !== box) p.classList.remove('open'); });
          });
        }
        panel(document.getElementById('rsetBtn'), document.getElementById('rsettings'));
        panel(document.getElementById('rtocBtn'), document.getElementById('rtoc'));
        document.addEventListener('click', function (e) {
          if (!e.target.closest('.rpanel') && !e.target.closest('.ricon')) {
            document.querySelectorAll('.rpanel').forEach(function (p) { p.classList.remove('open'); });
          }
        });

        // Settings controls.
        document.querySelector('[data-set="theme"]').addEventListener('click', function (e) {
          var v = e.target.dataset.val; if (!v) return; prefs.theme = v; apply();
        });
        document.querySelector('[data-set="font"]').addEventListener('click', function (e) {
          var v = e.target.dataset.val; if (!v) return;
          if (v === 'up') prefs.font = Math.min(2.1, prefs.font + 0.08);
          else if (v === 'down') prefs.font = Math.max(0.95, prefs.font - 0.08);
          else prefs.font = 1.25;
          apply();
        });
        document.querySelector('[data-set="lh"]').addEventListener('click', function (e) {
          var v = e.target.dataset.val; if (!v) return;
          prefs.lh = v === 'tight' ? 1.7 : v === 'airy' ? 2.5 : 2.15; apply();
        });

        // TOC smooth scroll + close.
        document.querySelectorAll('#rtoc a[data-goto]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            e.preventDefault();
            var el = document.getElementById(a.dataset.goto);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            document.getElementById('rtoc').classList.remove('open');
          });
        });

        // Progress bar + save/restore position.
        var bar = document.getElementById('rprogress');
        var ticking = false;
        function onScroll() {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var p = h > 0 ? window.scrollY / h : 0;
          bar.style.setProperty('--p', p);
          try { localStorage.setItem(K, String(window.scrollY)); } catch (e) {}
          ticking = false;
        }
        addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
        }, { passive: true });
        onScroll();
        try {
          var y = parseInt(localStorage.getItem(K) || '0', 10);
          if (y > 0) requestAnimationFrame(function () { window.scrollTo(0, y); });
        } catch (e) {}

        // Keyboard: t = contents, +/- = size, j/k or arrows = scroll.
        addEventListener('keydown', function (e) {
          if (e.target.matches('input,textarea')) return;
          if (e.key === 't') document.getElementById('rtocBtn')?.click();
          else if (e.key === '+' || e.key === '=') { prefs.font = Math.min(2.1, prefs.font + 0.08); apply(); }
          else if (e.key === '-') { prefs.font = Math.max(0.95, prefs.font - 0.08); apply(); }
          else if (e.key === 'j' || e.key === 'ArrowDown') scrollBy({ top: innerHeight * 0.9, behavior: 'smooth' });
          else if (e.key === 'k' || e.key === 'ArrowUp') scrollBy({ top: -innerHeight * 0.9, behavior: 'smooth' });
        });
      })();
    </script>
  </body>
</html>
