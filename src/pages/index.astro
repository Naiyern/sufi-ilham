---
import Base from '../layouts/Base.astro';
import BookTile from '../components/BookTile.astro';
import Cover from '../components/Cover.astro';
import AnimatedCover from '../components/AnimatedCover.astro';
import { books, published, series, seriesBooks, site, themes, journey, coverUrl, pdfUrl, byNewest, newReleases, isNewRelease, formatPublished, pageCount, latestPublished, seriesStructuredData } from '../data/site';
import { publicImageSize } from '../data/image-size';
import { resolvePortrait } from '../data/portrait';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Main portrait: whichever file exists in public/images/ (png/jpg/webp).
   width/height come from the real file at build time. */
const portrait = resolvePortrait();
const [portraitW, portraitH] = await publicImageSize(portrait.rel, [900, 1200]);
const [fluteW, fluteH] = await publicImageSize('images/sufi-ilham-flute.webp', [900, 900]);
const [childW, childH] = await publicImageSize('images/sufi-ilham-childhood.webp', [760, 760]);

const filters = [
  { id: 'all', label: 'All' },
  { id: 'new', label: 'New' },
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'self-help', label: 'Self-Help' },
  { id: 'fiction', label: 'Fiction' },
  { id: 'romance', label: 'Romance' },
  { id: 'romantasy', label: 'Romantasy' },
  { id: 'thriller', label: 'Thriller' },
  { id: 'free', label: 'Free to Read' },
  { id: 'ku', label: 'Kindle Unlimited' },
];

const seriesOptions = [
  { id: 'all', label: 'All books' },
  ...series.map((s) => ({
    id: s.id,
    label: s.name.replace(/^The /, '').replace(/ ·.*$/, '').replace(/ (Series|Trilogy)$/, ''),
  })),
  { id: 'standalone', label: 'Standalone' },
];

const pages = pageCount;
const recent = byNewest.slice(0, 10);
const indexed = [...byNewest, ...books.filter((b) => b.comingSoon)];
const newestNames = newReleases.map((b) => b.title).join(' and ');
const newestRomanNames = newReleases.map((b) => b.altTitle || b.title).join(' · ');
const cinematicReleaseArt = newReleases.find((b) => b.coverArt)?.coverArt;
const releaseBackdrop = cinematicReleaseArt
  ? coverUrl(cinematicReleaseArt, base)
  : `${base}/images/sufi-ilham-flute.webp`;

const ticker = [
  `${published.length} published titles`,
  `New · ${newReleases.map((b) => b.title).join(' · ')}`,
  'Philosophy · Romance · Thriller · Myth',
  `${published.filter((b) => b.ku).length} included in Kindle Unlimited`,
  'Discover books and series',
];

const jsonld = [
  ...series.map((s) => seriesStructuredData(s, site.url)),
  {
    '@context': 'https://schema.org', '@type': 'Person',
    name: site.name, alternateName: site.altName, jobTitle: 'Author',
    description: 'Author, deep thinker and seeker of truth exploring belief, consciousness, identity and self-discovery.',
    telephone: '+91-6201757330', url: site.url,
    image: `${site.url}/${portrait.rel}?v=${portrait.version}`,
    sameAs: [site.instagram, site.instagram2, site.amazonUS, site.amazonIN],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    name: 'Books by Sufi Ilham', numberOfItems: books.length,
    itemListElement: indexed.map((b, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: {
        '@type': 'Book', name: b.title,
        author: { '@type': 'Person', name: site.name, alternateName: site.altName },
        url: `${site.url}/books/${b.slug}/`, numberOfPages: b.pages ?? undefined,
        ...(b.published && b.published.length > 7 ? { datePublished: b.published } : {}),
        inLanguage: b.language ?? 'en',
      },
    })),
  },
];
---

<Base
  title={`Sufi Ilham — The Archive | ${published.length} Books on Belief, Love, Myth & Suspense`}
  description={`The complete works of Sufi Ilham (MD Naiyer Alam) — ${published.length} books. Newest: ${newestNames}.`}
  type="profile"
  jsonld={jsonld}
>
  <!-- ================= AUTHOR-FORWARD EDITORIAL HERO ================= -->
  <section
    class="cover editorial-hero"
    id="top"
    style={`--cinema-still:url("${base}/images/sufi-ilham-flute.webp")`}
  >
    <span class="cinema-light-leak" aria-hidden="true"></span>
    <div class="wrap">
      <div class="cover-top">
        <span>Author · Philosopher · Storyteller</span>
        <span>The collected works · {new Date().getFullYear()}</span>
      </div>

      <div class="hero-layout">
        <div class="hero-copy">
          <p class="hero-eyebrow label mark">
            <span class="hero-eyebrow-rule" aria-hidden="true"></span>
            Stories for a more examined life
          </p>
          <h1 id="author-name">
            <span class="ln"><span style="--d:.05s">Sufi</span></span>
            <span class="ln"><span style="--d:.15s" class="thin">Ilham</span></span>
          </h1>
          <p class="hero-intro">For the stories we live.<br />And the questions we carry.</p>
          <p class="lede hero-lede">
            {published.length} books on belief, love, myth and suspense — written by Sufi Ilham, the pen name of MD Naiyer Alam.
          </p>
          <div class="cover-cta hero-actions">
            <a class="btn solid" href="#new">
              Meet the latest book
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
            </a>
            <a class="btn" href={`${base}/discover/`}>Find your next read</a>
          </div>
          <p class="hero-location"><span class="label">Based in</span> {site.location}<span aria-hidden="true"> · </span>Available worldwide</p>
          <nav class="scene-nav reveal" aria-label="Explore the archive chapters">
            <a href="#new"><span class="scene-index" aria-hidden="true">01</span><span class="scene-title">Latest releases</span></a>
            <a href="#index"><span class="scene-index" aria-hidden="true">02</span><span class="scene-title">The archive</span></a>
            <a href="#series"><span class="scene-index" aria-hidden="true">03</span><span class="scene-title">Series</span></a>
            <a href="#essay"><span class="scene-index" aria-hidden="true">04</span><span class="scene-title">About the author</span></a>
          </nav>
        </div>

        <div class="hero-visual">
          <figure class="hero-portrait">
            <div class="hero-image-wrap">
              <img
                src={`${base}/${portrait.rel}?v=${portrait.version}`}
                alt="Portrait of Sufi Ilham, also known as MD Naiyer Alam"
                width={portraitW}
                height={portraitH}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <figcaption><span>MD Naiyer Alam</span><span>Writing as Sufi Ilham</span></figcaption>
          </figure>
          <a class="hero-note" href="#new" aria-label={`Latest releases: ${newestRomanNames}. Explore the new books`}>
            <span class="hero-note-label label mark">Latest releases · {formatPublished(latestPublished)}</span>
            <span class="hero-note-main">
              <span class="hero-note-covers" aria-hidden="true">
                {newReleases.slice(0, 2).map((b) => (
                  <Cover src={coverUrl(b.img, base)} title={b.altTitle || b.title} cls="hero-mini-cover" />
                ))}
              </span>
              <span class="hero-note-copy" dir="ltr">
                <span class="hero-note-title">{newestRomanNames}</span>
                <span class="hero-note-link">Explore the new books <span aria-hidden="true">↗</span></span>
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="hero-stats" role="group" aria-label="Sufi Ilham's catalogue at a glance">
        <div class="hero-stat"><strong>{published.length}</strong><span>Published titles</span></div>
        <div class="hero-stat"><strong>{pages.toLocaleString()}</strong><span>Pages across titles</span></div>
        <div class="hero-stat"><strong>{published.filter((b) => b.ku).length}</strong><span>On Kindle Unlimited</span></div>
        <div class="hero-stat"><strong>{series.length}</strong><span>Book series</span></div>
        <a class="hero-stat-link" href="#index">Enter the archive <span aria-hidden="true">↓</span></a>
      </div>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-in">
          {[...ticker, ...ticker].map((t) => <span>{t} <b>·</b></span>)}
        </div>
      </div>
    </div>
  </section>

  <nav class="chapter-rail" id="chapterRail" aria-label="Home page chapters">
    <a href="#top" data-chapter aria-label="Chapter 1: Opening frame" aria-current="location"><span class="chapter-index" aria-hidden="true">01</span><span class="chapter-name">Opening</span></a>
    <a href="#new" data-chapter aria-label="Chapter 2: Latest releases"><span class="chapter-index" aria-hidden="true">02</span><span class="chapter-name">Latest</span></a>
    <a href="#index" data-chapter aria-label="Chapter 3: The book archive"><span class="chapter-index" aria-hidden="true">03</span><span class="chapter-name">The archive</span></a>
    <a href="#series" data-chapter aria-label="Chapter 4: Book series"><span class="chapter-index" aria-hidden="true">04</span><span class="chapter-name">Series worlds</span></a>
    <a href="#essay" data-chapter aria-label="Chapter 5: The author"><span class="chapter-index" aria-hidden="true">05</span><span class="chapter-name">The author</span></a>
    <a href="#figures" data-chapter aria-label="Chapter 6: Themes and influences"><span class="chapter-index" aria-hidden="true">06</span><span class="chapter-name">Themes</span></a>
    <a href="#ending" data-chapter aria-label="Chapter 7: Closing words"><span class="chapter-index" aria-hidden="true">07</span><span class="chapter-name">Closing words</span></a>
    <a href="#enquiries" data-chapter aria-label="Chapter 8: Enquiries"><span class="chapter-index" aria-hidden="true">08</span><span class="chapter-name">Enquiries</span></a>
  </nav>

  <!-- ================= NEW RELEASES (dated, not hardcoded) ================= -->
  <section id="new" class="cinema-reel" style={`--reel-still:url("${releaseBackdrop}")`}>
    <div class="wrap">
      <div class="folio reveal">
        <h2>New releases</h2>
        <span class="label">{formatPublished(latestPublished)}</span>
      </div>
      <p class="lede reveal" style="margin-bottom:2rem">
        {newReleases.length === 1
          ? (newReleases[0].free
              ? `Free to read since ${formatPublished(latestPublished)} — read the whole book online, no payment.`
              : `Available on Amazon since ${formatPublished(latestPublished)} — explore the new release.`)
          : newReleases.length === 2
            ? `Two books went live on ${formatPublished(latestPublished)}${newReleases.every((b) => b.ku) ? ' — both included in Kindle Unlimited' : ''}.`
            : `${newReleases.length} books went live on ${formatPublished(latestPublished)}${newReleases.every((b) => b.ku) ? ', all included in Kindle Unlimited' : ''}.`}
      </p>

      <div class="release-grid">
        {newReleases.map((b, i) => {
          const src = coverUrl(b.img, base);
          const art = b.coverArt ? coverUrl(b.coverArt, base) : '';
          return (
            <article class="release reveal" style={`--d:${i * 80}ms`} data-slug={b.slug}>
              <a
                class="release-cover-link js-open"
                href={`${base}/books/${b.slug}/`}
                data-slug={b.slug}
                aria-haspopup="dialog"
                aria-controls="modal"
                aria-label={`Open details for ${b.altTitle || b.title}`}
              >
                <figure class="plate" style="margin:0">
                  <span class="ribbon">New</span>
                  <span class="release-sequence" aria-hidden="true">{String(i + 1).padStart(2, '0')} / {String(newReleases.length).padStart(2, '0')}</span>
                  {art ? (
                    <AnimatedCover
                      art={art}
                      title={b.title}
                      roman={b.altTitle}
                      tagline="A Part of the River"
                      author="صوفی الہام"
                      authorRoman="Sufi Ilham"
                      note="Free Urdu Novella"
                      dir={b.dir ?? 'rtl'}
                    />
                  ) : (
                    <Cover src={src} title={b.title} eager={i === 0} />
                  )}
                  <figcaption>
                    <span>{b.kicker}</span>
                    <span>{formatPublished(b.published)}</span>
                  </figcaption>
                </figure>
              </a>
              <div>
                <span class="label mark">{b.kicker}</span>
                <h3><a href={`${base}/books/${b.slug}/`} lang={b.language ?? 'en'} dir={b.dir ?? undefined}>{b.title}</a></h3>
                {b.sub && <p class="release-sub">{b.sub}</p>}
                {b.quote && <p class="pull">{b.quote}</p>}
                {b.blurb && <p>{b.blurb}</p>}
                <ul class="specs">{(b.spec ?? []).slice(0, 5).map((s) => <li>{s}</li>)}</ul>
                <div class="cover-cta">
                  {b.free && b.pdf ? (
                    <>
                      <a class="btn solid" href={`${base}/read/${b.slug}/`}>Read free →</a>
                      <a class="btn" href={`${base}/books/${b.slug}/`}>Book page</a>
                    </>
                  ) : (
                    <>
                      <button class="btn solid js-open" type="button" aria-haspopup="dialog" aria-controls="modal">Read more</button>
                      <a class="btn" href={`${base}/books/${b.slug}/`}>Book page</a>
                      {b.us && <a class="btn" href={b.us} target="_blank" rel="noopener">Amazon</a>}
                    </>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ================= SHELF ================= -->
  <section id="shelf" class="contact-sheet" style="padding-top:0">
    <div class="wrap">
      <div class="folio reveal">
        <h2>Recently published</h2>
        <span class="label">Newest first →</span>
      </div>
    </div>
    <div class="wrap">
      <div class="shelf-scroll reveal">
        {recent.map((b) => {
          const src = coverUrl(b.img, base);
          return (
            <a
              class="spine"
              href={`${base}/books/${b.slug}/`}
              data-slug={b.slug}
              aria-haspopup="dialog"
              aria-controls="modal"
              aria-label={`Open details for ${b.altTitle || b.title}`}
            >
              <span class="spine-img">
                {isNewRelease(b) && <span class="ribbon">New</span>}
                {b.coverArt ? (
                  <AnimatedCover
                    art={coverUrl(b.coverArt, base)}
                    title={b.title}
                    roman={b.altTitle}
                    tagline="A Part of the River"
                    author="صوفی الہام"
                    authorRoman="Sufi Ilham"
                    note="Free Urdu Novella"
                    dir={b.dir ?? 'rtl'}
                  />
                ) : (
                  <Cover src={src} title={b.title} />
                )}
              </span>
              <h3 lang={b.language ?? 'en'} dir={b.dir ?? undefined}>{b.title}</h3>
              <span class="label">
                {formatPublished(b.published)}{b.pages ? ` · ${b.pages} pp` : ''}{b.ku ? ' · KU' : ''}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="home-discovery" aria-labelledby="home-discovery-title">
    <div class="wrap home-discovery-grid">
      <div><span class="discover-overline">YOUR NEXT CHAPTER / START HERE</span><h2 id="home-discovery-title">Not sure where<br /><em>to begin?</em></h2></div>
      <div><p>Come for a question. Stay for a story. Find your way through the archive with reading paths for curious minds, open hearts and new worlds.</p><div class="home-paths"><a href={`${base}/discover/#path-01`}>Ideas &amp; meaning <span>↗</span></a><a href={`${base}/discover/#path-02`}>Love &amp; connection <span>↗</span></a><a href={`${base}/discover/#path-03`}>Fiction &amp; fantasy <span>↗</span></a><a href={`${base}/discover/#path-04`}>Life &amp; growth <span>↗</span></a></div><a class="home-discovery-link" href={`${base}/discover/`}>Explore the reader’s guide <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <!-- ================= THE INDEX (catalogue) ================= -->
  <section id="index" class="archive-chapter">
    <div class="wrap">
      <div class="folio reveal">
        <h2>Find your next book.</h2>
        <span class="label">{published.length} live · {books.length - published.length} forthcoming</span>
      </div>
      <p class="lede reveal" style="margin-bottom:2rem">
        Every title by Sufi Ilham, newest first. Open a book to explore its available editions, reading options and series.
      </p>

      <div class="catalog-controls reveal">
        <div class="filters" role="group" aria-label="Filter by genre or availability">
          {filters.map((f) => (
            <button type="button" class="fbtn" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
        <div class="catalog-tools">
          <label class="catalog-search">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            </svg>
            <span class="sr-only">Search titles, series, genres, languages, availability and summaries</span>
            <input id="bookSearch" type="search" placeholder="Title, series, theme…" autocomplete="off" aria-controls="bookGrid" />
          </label>
          <label class="catalog-select catalog-series">
            <span class="sr-only">Filter by series</span>
            <select id="seriesFilter" aria-controls="bookGrid">
              {seriesOptions.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
            <span aria-hidden="true">⌄</span>
          </label>
          <label class="catalog-select catalog-sort">
            <span class="sr-only">Sort books</span>
            <select id="bookSort" aria-controls="bookGrid">
              <option value="newest">Newest first</option>
              <option value="title">Title A–Z</option>
              <option value="pages">Fewest pages</option>
            </select>
            <span aria-hidden="true">⌄</span>
          </label>
          <span class="fcount" id="fcount" role="status" aria-live="polite" aria-atomic="true">Showing {books.length} of {books.length} titles</span>
          <button class="catalog-reset js-catalog-reset" id="catalogReset" type="button" hidden>Reset filters</button>
        </div>
      </div>

      <div class="catalog-grid reveal" id="bookGrid">
        {indexed.map((b, i) => <BookTile book={b} n={i + 1} />)}
      </div>
      <div class="catalog-empty" id="bookEmpty" hidden>
        <div>
          <p class="label mark">No matching books</p>
          <p>Try a broader title, theme or series, or reset the catalogue filters.</p>
        </div>
        <button class="catalog-reset js-catalog-reset" type="button">Reset catalogue</button>
      </div>
    </div>
  </section>

  <!-- ================= SERIES SPREADS ================= -->
  <div id="series">
    {series.map((s, i) => {
      const list = seriesBooks(s.id);
      return (
        <section class="spread series-spread" style={`--accent:${s.accent}`}>
          <div class="wrap spread-grid">
            <div class="reveal">
              <span class="spread-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="spread-fan">
                {list.slice(0, 4).map((b, j) => (
                  <img
                    src={coverUrl(b.img, base)}
                    alt="" loading="lazy" width="400" height="600" style={`--i:${j}`}
                  />
                ))}
              </div>
            </div>

            <div class="reveal" style="--d:100ms">
              <span class="label mark">{s.name}</span>
              <h2 style="margin:.5rem 0 1rem">{s.tagline}</h2>
              {s.hook && <p class="pull" style="font-size:clamp(1.2rem,2.4vw,1.7rem)">{s.hook}</p>}
              <p>{s.lede}</p>
              <ol class="ord">
                {list.map((b) => (
                  <li>
                    <b>{String(b.order).padStart(2, '0')}</b>
                    <a href={`${base}/books/${b.slug}/`}>{b.title}</a>
                    <span class="s">{b.comingSoon ? 'Soon' : b.pages ? `${b.pages} pp` : ''}</span>
                  </li>
                ))}
              </ol>
              <div class="cover-cta">
                <a class="btn" href={`${base}/series/${s.id}/`}>Explore the series →</a>
              </div>
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <!-- ================= ESSAY / AUTHOR ================= -->
  <section id="essay" class="spread author-chapter">
    <div class="wrap">
      <div class="folio reveal">
        <h2>The author</h2>
        <span class="label">A fearless pursuit of truth</span>
      </div>

      <div class="essay-grid">
        <div class="reveal">
          <figure class="plate author-main" style="margin:0">
            <img
              src={`${base}/${portrait.rel}?v=${portrait.version}`}
              alt="Portrait of Sufi Ilham"
              width={portraitW}
              height={portraitH}
              loading="lazy"
              decoding="async"
              style="width:100%;height:auto;display:block"
            />
            <figcaption><span>Sufi Ilham</span><span>MD Naiyer Alam</span></figcaption>
          </figure>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-top:.9rem">
            <figure class="plate" style="margin:0">
              <div class="author-frame" style="aspect-ratio:1/1;overflow:hidden;background:var(--paper-3);border:1px solid var(--rule)">
                <img
                  src={`${base}/images/sufi-ilham-flute.webp`}
                  alt="Sufi Ilham playing the bansuri"
                  width={fluteW}
                  height={fluteH}
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:100%;object-fit:cover;object-position:center top"
                />
              </div>
              <figcaption><span>The flute</span><span>Today</span></figcaption>
            </figure>
            <figure class="plate" style="margin:0">
              <div class="author-frame" style="aspect-ratio:1/1;overflow:hidden;background:var(--paper-3);border:1px solid var(--rule)">
                <img
                  src={`${base}/images/sufi-ilham-childhood.webp`}
                  alt="Sufi Ilham as a child"
                  width={childW}
                  height={childH}
                  loading="lazy"
                  decoding="async"
                  style="width:100%;height:100%;object-fit:cover;object-position:center top"
                />
              </div>
              <figcaption><span>Where it began</span><span>—</span></figcaption>
            </figure>
          </div>
        </div>

        <div class="reveal" style="--d:100ms">
          <p class="drop">
            Sufi Ilham, also known as MD Naiyer Alam, is an author, deep thinker, and seeker of truth who explores
            belief, consciousness, identity, and self-discovery.
          </p>
          <p>
            “Sufi Ilham” is a name I gave myself. To me, it represents the meaning I live — a reminder that life is
            not merely something to exist through, but something to understand, question, and experience authentically.
          </p>
          <p>
            My writing challenges inherited beliefs and societal conditioning, inviting readers to question
            assumptions rather than accept them blindly. I explore the raw and often uncomfortable realities of
            existence, philosophy, human nature, and the search for truth.
          </p>
          <p>
            I believe authenticity begins when we dare to look beyond what we have been taught and discover what is
            genuinely our own.
          </p>
          <p>
            Through my words, I seek to inspire transformation — to break free from conditioning, confront reality
            without fear, and live with greater clarity, courage, and awareness.
          </p>
          <p class="pull">Sufi Ilham is not just a name. It is a way of being.</p>
          <p class="sig">Sufi Ilham</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FIGURES / THEMES ================= -->
  <section id="figures" class="threads-chapter">
    <div class="wrap">
      <div class="folio reveal">
        <h2>Recurring threads</h2>
        <span class="label">What the work returns to</span>
      </div>
      <div class="cols reveal">
        {themes.map((t) => (
          <div class="col">
            <span class="num">{t.n}</span>
            <h3>{t.name}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>

      <div class="folio reveal" style="margin-top:4.5rem">
        <h2>The annals</h2>
        <span class="label">The path so far</span>
      </div>
      <div class="annals reveal">
        {journey.map((j) => (
          <div class="annal">
            <time>{j.date}</time>
            <div><h3>{j.title}</h3><p>{j.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= COLOPHON QUOTE ================= -->
  <section id="ending" class="closing-quote" aria-labelledby="closing-quote-text">
    <div class="wrap quote-stage">
      <span class="quote-glyph" aria-hidden="true">“</span>
      <span class="quote-prelude" aria-hidden="true"><span></span> A MOMENT TO REFLECT <span></span></span>
      <h2 id="closing-quote-text" class="quote-text">
        <span class="quote-line">“A journey of a</span>{' '}
        <span class="quote-line quote-line-emphasis">thousand miles</span>{' '}
        <span class="quote-line">begins with a single step.”</span>
      </h2>
      <p class="quote-credit">— Lao Tzu <span aria-hidden="true">·</span> Tao Te Ching, Chapter 64</p>
    </div>
  </section>

  <!-- ================= ENQUIRIES ================= -->
  <section id="enquiries" class="spread enquiry-chapter">
    <div class="wrap">
      <div class="folio reveal">
        <h2>Enquiries</h2>
        <span class="label">Get in touch</span>
      </div>

      <div class="essay-grid">
        <div class="reveal">
          <p class="lede">
            For reader messages, interviews, collaborations, bulk orders or translation rights — reach out directly.
          </p>
          <div class="rows" style="margin-top:1.6rem">
            <a class="rowlink" href={`tel:+${site.phoneRaw}`}>
              <span class="k">Phone</span><span class="v">{site.phone}</span><span class="arw">↗</span>
            </a>
            <a class="rowlink" href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">
              <span class="k">WhatsApp</span><span class="v">Message directly</span><span class="arw">↗</span>
            </a>
            <a class="rowlink" href={site.instagram} target="_blank" rel="noopener">
              <span class="k">Instagram</span><span class="v">@Sufiilham07</span><span class="arw">↗</span>
            </a>
            <a class="rowlink" href={site.instagram2} target="_blank" rel="noopener">
              <span class="k">Personal</span><span class="v">@naiyer_fx</span><span class="arw">↗</span>
            </a>
            <a class="rowlink" href={site.amazonUS} target="_blank" rel="noopener">
              <span class="k">Amazon</span><span class="v">Follow for new releases</span><span class="arw">↗</span>
            </a>
            <div class="rowlink">
              <span class="k">Based in</span><span class="v">{site.location} · Available worldwide</span>
            </div>
          </div>
        </div>

        <div class="form reveal" id="waForm" data-phone={site.phoneRaw} role="group" aria-label="Send a contact message via WhatsApp" aria-describedby="waNote" style="--d:100ms">
          <div><label for="n">Your name</label><input id="n" name="name" autocomplete="name" required /></div>
          <div><label for="e">Email</label><input id="e" name="email" type="email" autocomplete="email" required /></div>
          <div>
            <label for="s">Subject</label>
            <select id="s" name="subject">
              <option>Reader Message</option><option>Interview Request</option>
              <option>Collaboration</option><option>Bulk / Bookstore Order</option>
              <option>Translation Rights</option><option>Other</option>
            </select>
          </div>
          <div><label for="m">Message</label><textarea id="m" name="message" required></textarea></div>
          <button class="btn solid" id="waSend" type="button">Send via WhatsApp →</button>
          <p class="note" id="waNote" role="status" aria-live="polite">Opens in WhatsApp — nothing is stored on this website.</p>
        </div>
        <noscript><p class="note">JavaScript is off. Use the <a href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">direct WhatsApp link</a> to contact the author; these fields will not be submitted.</p></noscript>
      </div>

      <div class="subscribe reveal">
        <span class="label mark">The list</span>
        <h3 style="margin:.5rem 0 .4rem">Get notified of new books</h3>
        <p>Want a heads-up when a new book goes live? Send a direct request to the author through WhatsApp.</p>
        <div class="sub-form" id="newsForm" data-phone={site.phoneRaw} role="group" aria-label="Request new-release updates" aria-describedby="newsNote">
          <label class="sr-only" for="newsEmail">Email address</label>
          <input id="newsEmail" type="email" autocomplete="email" required placeholder="you@example.com" />
          <button class="btn solid" id="newsSend" type="button">Request via WhatsApp</button>
        </div>
        <noscript><p class="note">JavaScript is off. <a href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">Message the author on WhatsApp</a> to ask about release updates.</p></noscript>
        <p class="note" id="newsNote" role="status" aria-live="polite">WhatsApp opens with a pre-filled request. The author receives it only if you choose Send.</p>
      </div>
    </div>
  </section>

</Base>
