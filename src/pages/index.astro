---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import SeriesBand from '../components/SeriesBand.astro';
import Featured from '../components/Featured.astro';
import SpareKey from '../components/SpareKey.astro';
import CtaBand from '../components/CtaBand.astro';
import { books, published, series, site, stats, themes, journey, standalone } from '../data/site';
import seriesLd from '../data/series-jsonld.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const filters = [
  { id: 'all', label: `All ${books.length}` },
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'self-help', label: 'Self-Help' },
  { id: 'fiction', label: 'Fiction' },
  { id: 'romance', label: 'Romance' },
  { id: 'romantasy', label: 'Romantasy' },
  { id: 'ku', label: 'Kindle Unlimited' },
];

const featured = standalone.slice(0, 1)[0];

const jsonld = [
  ...Object.values(seriesLd as Record<string, unknown>),
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    alternateName: site.altName,
    jobTitle: 'Author',
    description:
      'Author, deep thinker and seeker of truth exploring belief, consciousness, identity and self-discovery.',
    telephone: '+91-6201757330',
    url: site.url,
    image: `${site.url}/images/sufi-ilham-portrait.jpg`,
    sameAs: [site.instagram, site.instagram2, site.amazonUS, site.amazonIN],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Books by Sufi Ilham',
    numberOfItems: books.length,
    itemListElement: books.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Book',
        name: b.title,
        author: { '@type': 'Person', name: site.name, alternateName: site.altName },
        url: b.us || site.url,
        numberOfPages: b.pages ?? undefined,
        inLanguage: 'en',
      },
    })),
  },
];
---

<Base
  title={`Sufi Ilham — Author of ${published.length} Books | Philosophy, Romance, Myth & Dark Romantasy`}
  description={`Official website of Sufi Ilham (MD Naiyer Alam) — author of ${published.length} books across philosophy, self-help, literary fiction, small-town romance, mythic romance and dark romantasy.`}
  type="profile"
  jsonld={jsonld}
>
  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="wrap hero-grid">
      <div>
        <div class="sec-tag" data-i18n="hero.eyebrow">{published.length} Books · Philosophy, Romance, Myth &amp; Dark Romantasy</div>
        <h1>
          <span class="l"><span style="--d:.05s">Sufi</span></span>
          <span class="l"><span style="--d:.16s">Ilham</span></span>
        </h1>
        <p class="sub" data-i18n="hero.alias">Also known as MD Naiyer Alam</p>
        <p class="lede">
          An author, deep thinker and seeker of truth exploring belief, consciousness and identity — writing that
          challenges societal norms and asks you to question every assumption you inherited.
        </p>
        <p class="lede" style="color:var(--fg-mute);font-size:.95rem">
          From the architecture of belief to the illusion of time — five small-town love stories in Maple Falls,
          a gothic romantasy trilogy, the seven-book Cartographers saga, the mythic Song of the Unbroken Sky and
          the standalone romance The Spare Key Summer.
        </p>
        <div class="hero-cta">
          <a class="btn pri" href="#books" data-i18n="hero.cta2">Browse all books →</a>
          {featured?.us && <a class="btn" href={featured.us} target="_blank" rel="noopener" data-i18n="hero.cta1">Read the new release</a>}
        </div>
      </div>

      <div class="portrait-wrap reveal">
        <div class="portrait-ring"></div>
        <div class="portrait">
          <img
            src={`${base}/images/sufi-ilham-portrait.jpg`}
            alt="Portrait of Sufi Ilham"
            width="900" height="1200" fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <div class="wrap">
      <a class="scroll-hint" href="#featured" aria-label="Scroll to content">
        <span data-i18n="hero.scroll">Scroll</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
      <div class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <b data-count={s.n} data-suffix={s.suffix ?? ''}>0</b>
            <span data-i18n={s.key}>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Featured />

  <!-- ============ ALL BOOKS ============ -->
  <section id="books">
    <div class="wrap">
      <div class="reveal">
        <div class="sec-tag" data-i18n="books.tag">The Library</div>
        <h2>Every book, <em>one shelf</em></h2>
        <p class="sec-sub">
          Every title by Sufi Ilham — in Kindle and paperback, worldwide on Amazon. Click any book to read more.
          Filter by genre, or search by title.
        </p>
      </div>

      <div class="toolbar reveal">
        {filters.map((f) => (
          <button class="chip" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}</button>
        ))}
        <input class="search" id="bookSearch" type="search" placeholder="Search titles…" aria-label="Search books" />
      </div>

      <div class="grid" id="bookGrid">
        {books.map((b, i) => <BookCard book={b} delay={(i % 8) * 60} />)}
      </div>
      <p id="bookEmpty" style="display:none;text-align:center;padding:3rem 0;color:var(--fg-mute)">
        No books match that search.
      </p>
    </div>
  </section>

  <!-- ============ SERIES ============ -->
  <div id="series">
    {series.map((s) => <SeriesBand s={s} />)}
  </div>

  <SpareKey />

  <!-- ============ QUOTE ============ -->
  <section class="quote-sec">
    <div class="wrap reveal">
      <blockquote data-i18n="quote.text">“The map is not the country. Walk until you know the difference.”</blockquote>
      <cite data-i18n="quote.cite">— The Map Is Finished</cite>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about">
    <div class="wrap about-grid">
      <div class="about-photo reveal">
        <img src={`${base}/images/sufi-ilham-portrait.jpg`} alt="Sufi Ilham" width="900" height="900" loading="lazy" />
        <div class="cap">Sufi Ilham · MD Naiyer Alam</div>
        <div class="gal">
          <figure>
            <img src={`${base}/images/sufi-ilham-flute.jpg`} alt="Sufi Ilham playing the bansuri flute" width="760" height="760" loading="lazy" />
            <figcaption>The flute · today</figcaption>
          </figure>
          <figure>
            <img src={`${base}/images/sufi-ilham-childhood.jpg`} alt="Sufi Ilham as a child" width="760" height="760" loading="lazy" />
            <figcaption>Where it began</figcaption>
          </figure>
        </div>
      </div>

      <div class="about-body reveal" style="--d:120ms">
        <div class="sec-tag" data-i18n="about.tag">About the Author</div>
        <h2 style="margin-bottom:1.6rem" data-i18n="about.head">A fearless pursuit <em>of truth</em></h2>
        <p class="first">
          Sufi Ilham, also known as MD Naiyer Alam, is an author, deep thinker, and seeker of truth who explores
          belief, consciousness, identity, and self-discovery.
        </p>
        <p>
          “Sufi Ilham” is a name I gave myself. To me, it represents the meaning I live — a reminder that life is
          not merely something to exist through, but something to understand, question, and experience authentically.
        </p>
        <p>
          My writing challenges inherited beliefs and societal conditioning, inviting readers to question assumptions
          rather than accept them blindly. I explore the raw and often uncomfortable realities of existence,
          philosophy, human nature, and the search for truth.
        </p>
        <p>
          I believe authenticity begins when we dare to look beyond what we have been taught and discover what is
          genuinely our own. Through my words, I seek to inspire transformation — to break free from conditioning,
          confront reality without fear, and live with greater clarity, courage, and awareness.
        </p>
        <p class="about-creed" data-i18n="about.creed">Sufi Ilham is not just a name. It is a way of being.</p>
      </div>
    </div>
  </section>

  <!-- ============ THEMES ============ -->
  <section id="themes">
    <div class="wrap">
      <div class="reveal">
        <div class="sec-tag" data-i18n="themes.tag">Recurring Threads</div>
        <h2 data-i18n="themes.head">What the work <em>keeps returning to</em></h2>
      </div>
      <div class="t-grid reveal">
        {themes.map((t) => (
          <div class="t-cell">
            <b>{t.n}</b>
            <h3 data-i18n={`th${t.n.replace(/^0/, "")}`}>{t.name}</h3>
            <p data-i18n={`th${t.n.replace(/^0/, "")}d`}>{t.text}</p>
          </div>
        ))}
      </div>

      <div class="reveal" style="margin-top:5rem">
        <div class="sec-tag" data-i18n="jour.tag">The Path So Far</div>
        <h2 data-i18n="jour.head">A writing <em>journey</em></h2>
      </div>
      <div class="time reveal">
        {journey.map((j) => (
          <div class="tl">
            <time>{j.date}</time>
            <div>
              <h3>{j.title}</h3>
              <p>{j.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact">
    <div class="wrap contact-grid">
      <div class="reveal">
        <div class="sec-tag" data-i18n="con.tag">Get In Touch</div>
        <h2 data-i18n="con.head">Say <em>hello</em></h2>
        <p class="sec-sub">
          For reader messages, interviews, collaborations, bulk orders or translation rights — reach out directly.
        </p>
        <div class="c-list">
          <a class="c-row" href={`tel:+${site.phoneRaw}`}>
            <span class="ic">☏</span><span class="tx"><b>Phone</b><span>{site.phone}</span></span>
          </a>
          <a class="c-row" href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">
            <span class="ic">✆</span><span class="tx"><b>WhatsApp</b><span>Message directly</span></span>
          </a>
          <a class="c-row" href={site.instagram} target="_blank" rel="noopener">
            <span class="ic">◎</span><span class="tx"><b>Instagram · Author</b><span>@Sufiilham07</span></span>
          </a>
          <a class="c-row" href={site.instagram2} target="_blank" rel="noopener">
            <span class="ic">◎</span><span class="tx"><b>Instagram · Personal</b><span>@naiyer_fx</span></span>
          </a>
          <a class="c-row" href={site.amazonUS} target="_blank" rel="noopener">
            <span class="ic">✦</span><span class="tx"><b>Amazon Author Store</b><span>Follow for new releases</span></span>
          </a>
          <div class="c-row">
            <span class="ic">◈</span><span class="tx"><b>Based in {site.location}</b><span>Available worldwide</span></span>
          </div>
        </div>
      </div>

      <form class="form reveal" id="waForm" data-phone={site.phoneRaw} style="--d:100ms">
        <div><label for="n" data-i18n="con.name">Your Name</label><input id="n" name="name" required /></div>
        <div><label for="e" data-i18n="con.email">Email</label><input id="e" name="email" type="email" required /></div>
        <div>
          <label for="s" data-i18n="con.subject">Subject</label>
          <select id="s" name="subject">
            <option>Reader Message</option>
            <option>Interview Request</option>
            <option>Collaboration</option>
            <option>Bulk / Bookstore Order</option>
            <option>Translation Rights</option>
            <option>Other</option>
          </select>
        </div>
        <div><label for="m" data-i18n="con.msg">Message</label><textarea id="m" name="message" required></textarea></div>
        <button class="btn pri" type="submit" data-i18n="con.send">Send via WhatsApp →</button>
        <p class="note">
          Your message opens in WhatsApp to {site.phone} — nothing is stored on this website.
        </p>
      </form>
    </div>
  </section>
  <CtaBand />
</Base>
