---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page not found — Sufi Ilham" description="Find your way back to the books of Sufi Ilham.">
  <section class="not-found">
    <div class="wrap not-found-grid">
      <div>
        <p class="not-found-kicker">THE ARCHIVE / PAGE NOT FOUND</p>
        <h1>Even the best stories<br /><em>take a wrong turn.</em></h1>
        <p class="not-found-intro">The page you were looking for isn’t here. But there are plenty of other stories waiting for you.</p>
        <div class="cover-cta"><a class="btn solid" href={`${base}/`}>Return home <span aria-hidden="true">↗</span></a><a class="btn" href={`${base}/discover/`}>Find your next read <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="not-found-number" aria-hidden="true"><span>LOST IN THE ARCHIVE</span><b>404</b><i>Every ending is a beginning.</i></div>
    </div>
  </section>
</Base>
