---
import Base from '../layouts/Base.astro';
import { resolvePortrait } from '../data/portrait';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portrait = resolvePortrait();
---

<Base
  title="Change Main Photo — Sufi Ilham"
  description="Preview and replace your main author portrait. Your exact image is used as-is — no cropping, no AI — and looks identical on mobile, tablet and desktop."
>
  <section style="padding-top:6rem">
    <div class="wrap">
      <p class="crumb"><a href={`${base}/`}>Home</a> · Change photo</p>

      <div class="folio reveal" style="margin-top:1.2rem">
        <h2>Change main photo</h2>
        <span class="label">Exact image · No crop · No AI</span>
      </div>

      <p class="lede" style="margin-bottom:2rem">
        Drop the photo you want as your main portrait — <b>exactly as it is</b>. Nothing is cropped,
        filtered, resized or regenerated. The two previews below show your untouched image at desktop
        and phone width so you can confirm it reads well on every device before publishing.
      </p>

      <div class="essay-grid" style="align-items:start">
        <!-- LEFT: uploader + device previews -->
        <div class="reveal">
          <div
            id="drop"
            style="border:2px dashed var(--rule-2);padding:1.6rem;text-align:center;background:var(--field);cursor:pointer"
          >
            <p style="margin:0 0 .6rem;font-family:var(--display);font-size:1.3rem">Drop your photo here</p>
            <p class="note">or click to browse · JPG, PNG, WebP — any size, any ratio</p>
            <input id="file" type="file" accept="image/*" style="display:none" />
            <p id="fileName" class="note" style="margin-top:.8rem;color:var(--mark)"></p>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-top:1rem">
            <div>
              <span class="label">Desktop preview</span>
              <div
                style="margin-top:.4rem;background:var(--paper-3);border:1px solid var(--rule)"
              >
                <img
                  id="prevDesktop"
                  src={`${base}/${portrait.rel}`}
                  alt="Desktop preview"
                  style="width:100%;height:auto;display:block"
                />
              </div>
              <span class="note">520 px column · full image, native ratio</span>
            </div>
            <div>
              <span class="label">Phone / tablet preview</span>
              <div
                style="margin-top:.4rem;background:var(--paper-3);border:1px solid var(--rule);max-width:280px;margin-inline:auto"
              >
                <img
                  id="prevPhone"
                  src={`${base}/${portrait.rel}`}
                  alt="Phone preview"
                  style="width:100%;height:auto;display:block"
                />
              </div>
              <span class="note">92vw · identical image, never stretched</span>
            </div>
          </div>

          <div style="display:flex;gap:.6rem;margin-top:1.2rem;flex-wrap:wrap">
            <button class="btn solid" id="btnDownload" type="button">Download exact image (unchanged)</button>
            <button class="btn" id="btnReset" type="button">Reset to current</button>
          </div>
          <p class="note" style="margin-top:.6rem">
            Download saves your original file byte-for-byte, already named
            <code>sufi-ilham-portrait.png</code> / <code>.jpg</code>, ready to drop into <code>public/images/</code>.
          </p>
        </div>

        <!-- RIGHT: instructions -->
        <div class="reveal" style="--d:100ms">
          <h3>How to publish it (30 seconds)</h3>

          <div style="background:var(--paper-2);border:1px solid var(--rule);padding:1.2rem;margin:1rem 0">
            <span class="label">Option A — upload on GitHub (no computer setup)</span>
            <ol style="margin:.7rem 0 0;padding-left:1.2rem;color:var(--ink-2)">
              <li>Download the exact image above (or use your original file).</li>
              <li>
                One-time (1 min): on GitHub create the file
                <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)">.github/workflows/rebuild-on-photo-upload.yml</code>
                and paste the contents of
                <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)">docs/rebuild-on-photo-upload.yml</code>
                from this repo.
              </li>
              <li>
                Then upload your photo into
                <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)">public/images/</code>
                as <code>sufi-ilham-portrait.png</code> (or <code>.jpg</code>), replacing the old file —
                the action rebuilds and deploys automatically (~2 minutes), untouched.
              </li>
            </ol>
          </div>

          <div style="background:var(--paper-2);border:1px solid var(--rule);padding:1.2rem">
            <span class="label">Option B — one command (local copy, byte-for-byte)</span>
            <p class="note" style="margin:.5rem 0">If you have the photo anywhere on your computer:</p>
            <pre
              style="background:var(--ink);color:var(--paper);padding:.9rem;overflow-x:auto;font-size:.78rem;border-radius:2px"><code>node scripts/replace-portrait.mjs /path/to/your-photo.png
npm run build && cp -r dist/. .
git add -A && git commit -m "new portrait" && git push</code></pre>
            <p class="note">
              The script copies your file <b>byte-for-byte</b> (no crop, no resize, no AI) into
              <code>public/images/</code>, <code>src/assets/</code> and <code>images/</code>, and removes
              old cropped variants.
            </p>
          </div>

          <h3 style="margin-top:2rem">Why it looks the same on every device</h3>
          <ul style="color:var(--ink-2);padding-left:1.1rem">
            <li>
              <b>Full frame, native ratio:</b> the portrait renders at <code>width:100%; height:auto</code> —
              the whole image, exactly as uploaded, on phone, tablet and desktop alike.
            </li>
            <li>
              <b>Responsive accuracy layer:</b> one shared set of breakpoints (375 → 1100 px+) in
              <code>global.css</code> keeps columns, spacing and type identical across devices.
            </li>
            <li>
              <b>Single source of truth:</b> <code>width</code>/<code>height</code> are read from the real
              file at build time, so no layout shift on any device.
            </li>
          </ul>

          <div class="cover-cta" style="margin-top:1.6rem">
            <a class="btn solid" href={`${base}/#essay`}>← Back to author section</a>
            <a class="btn" href={`${base}/`} target="_self">View homepage</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const file = document.getElementById('file');
      const drop = document.getElementById('drop');
      const nameEl = document.getElementById('fileName');
      const prevD = document.getElementById('prevDesktop');
      const prevP = document.getElementById('prevPhone');
      const btnDl = document.getElementById('btnDownload');
      const btnReset = document.getElementById('btnReset');
      const originalSrc = prevD.src;
      let currentFile = null;

      const setPreview = (url, name, f) => {
        prevD.src = url;
        prevP.src = url;
        currentFile = f || null;
        if (nameEl) nameEl.textContent = name ? `Selected: ${name}` : '';
      };

      const handleFile = (f) => {
        if (!f || !f.type.startsWith('image/')) return;
        setPreview(URL.createObjectURL(f), f.name, f);
      };

      drop?.addEventListener('click', () => file?.click());
      drop?.addEventListener('dragover', (e) => {
        e.preventDefault();
        drop.style.borderColor = 'var(--mark)';
      });
      drop?.addEventListener('dragleave', () => (drop.style.borderColor = ''));
      drop?.addEventListener('drop', (e) => {
        e.preventDefault();
        drop.style.borderColor = '';
        const f = e.dataTransfer?.files?.[0];
        if (f) handleFile(f);
      });
      file?.addEventListener('change', () => {
        const f = file.files?.[0];
        if (f) handleFile(f);
      });

      btnReset?.addEventListener('click', () => {
        setPreview(originalSrc, '', null);
        if (file) file.value = '';
      });

      // Download: the untouched original bytes, renamed for the repo
      btnDl?.addEventListener('click', () => {
        if (!currentFile) {
          if (nameEl) nameEl.textContent = 'Pick or drop a photo first — the download saves your exact file.';
          return;
        }
        const ext = (currentFile.name.match(/\.(png|jpe?g|webp)$/i)?.[0] || '.jpg').toLowerCase();
        const a = document.createElement('a');
        a.download = `sufi-ilham-portrait${ext === '.jpeg' ? '.jpg' : ext}`;
        a.href = URL.createObjectURL(currentFile);
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      });
    })();
  </script>
</Base>
