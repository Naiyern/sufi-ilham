---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Change Main Photo — Sufi Ilham"
  description="Preview and replace your main author portrait. Any shape works — the site auto-crops it to look perfect on mobile, tablet and desktop."
>
  <section style="padding-top:6rem">
    <div class="wrap">
      <p class="crumb"><a href={`${base}/`}>Home</a> · Change photo</p>

      <div class="folio reveal" style="margin-top:1.2rem">
        <h2>Change main photo</h2>
        <span class="label">Any shape · Auto-cropped</span>
      </div>

      <p class="lede" style="margin-bottom:2rem">
        Drop <b>any</b> photo you want as your main portrait — phone vertical, 4:5, square, or landscape.
        The preview below shows <b>exactly</b> how it will look on desktop, tablet and phone (cropped to a clean editorial square, never stretched).
        When you're happy, download the optimized file or follow the one-line replacement below.
      </p>

      <div class="essay-grid" style="align-items:start">
        <!-- LEFT: uploader + device previews -->
        <div class="reveal">
          <div
            id="drop"
            style="border:2px dashed var(--rule-2);padding:1.6rem;text-align:center;background:var(--field);cursor:pointer"
          >
            <p style="margin:0 0 .6rem;font-family:var(--display);font-size:1.3rem">Drop your photo here</p>
            <p class="note">or click to browse · JPG, PNG, WebP, HEIC — any size</p>
            <input id="file" type="file" accept="image/*" style="display:none" />
            <p id="fileName" class="note" style="margin-top:.8rem;color:var(--mark)"></p>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-top:1rem">
            <div>
              <span class="label">Desktop preview</span>
              <div
                style="margin-top:.4rem;aspect-ratio:1/1;overflow:hidden;background:var(--paper-3);border:1px solid var(--rule)"
              >
                <img
                  id="prevDesktop"
                  src={`${base}/images/sufi-ilham-portrait.jpg`}
                  alt="Desktop preview"
                  style="width:100%;height:100%;object-fit:cover;object-position:center 18%"
                />
              </div>
              <span class="note">520 px · 1:1 editorial square</span>
            </div>
            <div>
              <span class="label">Phone / tablet preview</span>
              <div
                style="margin-top:.4rem;aspect-ratio:1/1;overflow:hidden;background:var(--paper-3);border:1px solid var(--rule);max-width:280px;margin-inline:auto"
              >
                <img
                  id="prevPhone"
                  src={`${base}/images/sufi-ilham-portrait.jpg`}
                  alt="Phone preview"
                  style="width:100%;height:100%;object-fit:cover;object-position:center 18%"
                />
              </div>
              <span class="note">92vw · same crop, never stretched</span>
            </div>
          </div>

          <div style="display:flex;gap:.6rem;margin-top:1.2rem;flex-wrap:wrap">
            <button class="btn solid" id="btnDownload" type="button">Download optimized 1200×1200 JPG</button>
            <button class="btn" id="btnReset" type="button">Reset to current</button>
          </div>
          <p class="note" style="margin-top:.6rem">
            Download gives you a 1200×1200 face-aware crop ready to drop into <code>public/images/</code>.
          </p>
        </div>

        <!-- RIGHT: instructions -->
        <div class="reveal" style="--d:100ms">
          <h3>How to replace permanently (30 seconds)</h3>

          <div style="background:var(--paper-2);border:1px solid var(--rule);padding:1.2rem;margin:1rem 0">
            <span class="label">Option A — drag & replace (easiest)</span>
            <ol style="margin:.7rem 0 0;padding-left:1.2rem;color:var(--ink-2)">
              <li>Download the optimized JPG above (or use your original).</li>
              <li>
                Replace this file in your repo:<br />
                <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)"
                  >public/images/sufi-ilham-portrait.jpg</code
                >
              </li>
              <li>
                Copy the same file to:<br />
                <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)"
                  >src/assets/sufi-ilham-portrait.jpg</code
                >
                and <code style="font-size:.78rem;background:var(--field);padding:.2rem .4rem;border:1px solid var(--rule)"
                  >images/sufi-ilham-portrait.jpg</code
                >
              </li>
              <li>Run <code>npm run build</code> to see it locally, then <code>git push</code> — live in 1–2 min.</li>
            </ol>
          </div>

          <div style="background:var(--paper-2);border:1px solid var(--rule);padding:1.2rem">
            <span class="label">Option B — one command (auto-crop)</span>
            <p class="note" style="margin:.5rem 0">If you have the photo anywhere on your computer:</p>
            <pre
              style="background:var(--ink);color:var(--paper);padding:.9rem;overflow-x:auto;font-size:.78rem;border-radius:2px"><code>node scripts/replace-portrait.mjs /path/to/your-photo.jpg
npm run build</code></pre>
            <p class="note">
              The script auto-rotates by EXIF, face-aware crops to a centered square (so 4:5 or phone verticals never stretch),
              writes all three locations, and generates 400/600/900/1200 JPG + WebP variants.
            </p>
          </div>

          <h3 style="margin-top:2rem">Why it stays accurate on all devices</h3>
          <ul style="color:var(--ink-2);padding-left:1.1rem">
            <li>
              <b>Frame, not image:</b> CSS <code>aspect-ratio:1/1</code> + <code>object-fit:cover</code> + <code
                >object-position:center 18%</code
              > — any source shape is cropped, never stretched.
            </li>
            <li><b>Responsive srcset:</b> phone loads 400w (29 KB), tablet 600w (55 KB), desktop 900–1200w — fast everywhere, sharp everywhere.</li>
            <li><b>Single source of truth:</b> width/height read at build time via <code>sharp</code>, so you never hand-edit numbers.</li>
          </ul>

          <div class="cover-cta" style="margin-top:1.6rem">
            <a class="btn solid" href={`${base}/#essay`}>← Back to author section</a>
            <a class="btn" href={`${base}/`} target="_self">View homepage</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const file = document.getElementById('file');
      const drop = document.getElementById('drop');
      const nameEl = document.getElementById('fileName');
      const prevD = document.getElementById('prevDesktop');
      const prevP = document.getElementById('prevPhone');
      const btnDl = document.getElementById('btnDownload');
      const btnReset = document.getElementById('btnReset');
      const originalSrc = prevD.src;
      let currentDataUrl = null;
      let currentName = '';

      const setPreview = (url, name) => {
        prevD.src = url;
        prevP.src = url;
        currentDataUrl = url;
        currentName = name || '';
        if (nameEl) nameEl.textContent = name ? `Selected: ${name}` : '';
      };

      const handleFile = (f) => {
        if (!f || !f.type.startsWith('image/')) return;
        const url = URL.createObjectURL(f);
        setPreview(url, f.name);
      };

      drop?.addEventListener('click', () => file?.click());
      drop?.addEventListener('dragover', (e) => {
        e.preventDefault();
        drop.style.borderColor = 'var(--mark)';
      });
      drop?.addEventListener('dragleave', () => (drop.style.borderColor = ''));
      drop?.addEventListener('drop', (e) => {
        e.preventDefault();
        drop.style.borderColor = '';
        const f = e.dataTransfer?.files?.[0];
        if (f) handleFile(f);
      });
      file?.addEventListener('change', () => {
        const f = file.files?.[0];
        if (f) handleFile(f);
      });

      btnReset?.addEventListener('click', () => {
        setPreview(originalSrc, '');
        if (file) file.value = '';
      });

      // Download: create a 1200×1200 face-aware-ish canvas crop (center 18% bias) client-side
      btnDl?.addEventListener('click', async () => {
        const src = currentDataUrl || originalSrc;
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.src = src;
        await new Promise((r, j) => {
          img.onload = r;
          img.onerror = j;
        });
        const size = 1200;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        // cover crop: fill square, bias 18% from top
        const iw = img.naturalWidth;
        const ih = img.naturalHeight;
        const scale = Math.max(size / iw, size / ih);
        const sw = iw * scale;
        const sh = ih * scale;
        const dx = (size - sw) / 2;
        // 18% top bias: shift image up slightly so face stays centred
        const dy = (size - sh) / 2 - sh * 0.06;
        ctx.fillStyle = '#f3f0e9';
        ctx.fillRect(0, 0, size, size);
        ctx.drawImage(img, dx, dy, sw, sh);
        const a = document.createElement('a');
        a.download = 'sufi-ilham-portrait-1200.jpg';
        a.href = canvas.toDataURL('image/jpeg', 0.85);
        a.click();
      });
    })();
  </script>
</Base>
